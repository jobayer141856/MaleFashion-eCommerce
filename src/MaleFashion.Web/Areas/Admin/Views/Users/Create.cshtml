@model MaleFashion.Web.Areas.Admin.Models.Security.AdminCreateUserModel

@{
    ViewData["Title"] = "Create Staff Account";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-9 col-lg-11 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom py-3">
                    <div>
                        <h5 class="card-title mb-0">
                            <i class="bx bx-user-plus text-primary me-2"></i>Create New User / Staff
                        </h5>
                        <small class="text-muted">Provision a new user account and configure their administrative roles</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to Users
                    </a>
                </div>

                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    <form asp-action="Create" method="post" id="formCreateUser">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Personal Information -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">
                            <i class="bx bx-id-card me-1 text-primary"></i>1. Account Details
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="FirstName"></label>
                                <input class="form-control" asp-for="FirstName" placeholder="e.g. John" autofocus />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="LastName"></label>
                                <input class="form-control" asp-for="LastName" placeholder="e.g. Doe" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="Email"></label>
                                <input class="form-control" asp-for="Email" placeholder="staff@domain.com" type="email" autocomplete="username" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="PhoneNumber"></label>
                                <input class="form-control" asp-for="PhoneNumber" placeholder="+880 1700-000000" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Password Setup -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">
                            <i class="bx bx-lock-alt me-1 text-primary"></i>2. Security Credentials
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6 form-password-toggle">
                                <label class="form-label fw-semibold" asp-for="Password"></label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" asp-for="Password" type="password" id="userPassword" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" autocomplete="new-password" />
                                    <span class="input-group-text cursor-pointer" onclick="togglePasswordVisibility('userPassword', this)">
                                        <i class="bx bx-hide"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-password-toggle">
                                <label class="form-label fw-semibold" asp-for="ConfirmPassword"></label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" asp-for="ConfirmPassword" type="password" id="userConfirmPassword" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" autocomplete="new-password" />
                                    <span class="input-group-text cursor-pointer" onclick="togglePasswordVisibility('userConfirmPassword', this)">
                                        <i class="bx bx-hide"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Role Assignments -->
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">
                            <i class="bx bx-shield-quarter me-1 text-primary"></i>3. Role-Based Access Assignment
                        </h6>

                        <div class="list-group mb-4">
                            @if (Model.Roles != null && Model.Roles.Any())
                            {
                                @for (int i = 0; i < Model.Roles.Count; i++)
                                {
                                    <input type="hidden" asp-for="@Model.Roles[i].RoleId" />
                                    <input type="hidden" asp-for="@Model.Roles[i].RoleName" />

                                    <label class="list-group-item d-flex align-items-center justify-content-between p-3">
                                        <div class="d-flex align-items-center">
                                            <input class="form-check-input me-3"
                                                   type="checkbox"
                                                   asp-for="@Model.Roles[i].IsSelected" />
                                            <div>
                                                <strong class="text-heading">@Model.Roles[i].RoleName</strong>
                                                @if (Model.Roles[i].RoleName == "SuperAdmin")
                                                {
                                                    <span class="badge bg-label-danger ms-2">Super Administrator</span>
                                                }
                                                else if (Model.Roles[i].RoleName == "Admin")
                                                {
                                                    <span class="badge bg-label-primary ms-2">Full Administrator</span>
                                                }
                                                else if (Model.Roles[i].RoleName == "OrderManager")
                                                {
                                                    <span class="badge bg-label-info ms-2">Sales & Orders</span>
                                                }
                                                else if (Model.Roles[i].RoleName == "CatalogManager")
                                                {
                                                    <span class="badge bg-label-warning ms-2">Catalog & Products</span>
                                                }
                                                else if (Model.Roles[i].RoleName == "BlogEditor")
                                                {
                                                    <span class="badge bg-label-secondary ms-2">Blog Content</span>
                                                }
                                                else if (Model.Roles[i].RoleName == "SupportStaff")
                                                {
                                                    <span class="badge bg-label-dark ms-2">Support & Inquiries</span>
                                                }
                                                else if (Model.Roles[i].RoleName == "Customer")
                                                {
                                                    <span class="badge bg-label-success ms-2">Storefront Shopper</span>
                                                }
                                            </div>
                                        </div>
                                    </label>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    No roles are currently configured in the system. Create roles under <a asp-controller="Roles" asp-action="Index">Role Management</a> first.
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bx bx-check-circle me-1"></i> Provision Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePasswordVisibility(inputId, toggleEl) {
            const input = document.getElementById(inputId);
            const icon = toggleEl.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bx-hide');
                icon.classList.add('bx-show');
            } else {
                input.type = 'password';
                icon.classList.remove('bx-show');
                icon.classList.add('bx-hide');
            }
        }
    </script>
}

