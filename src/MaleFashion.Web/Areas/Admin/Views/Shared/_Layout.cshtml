@using MaleFashion.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isSuperOrAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var canManageOrders = isSuperOrAdmin || User.IsInRole("OrderManager");
    var canManageCatalog = isSuperOrAdmin || User.IsInRole("CatalogManager");
    var canManageBlog = isSuperOrAdmin || User.IsInRole("BlogEditor");
    var canManageSupport = isSuperOrAdmin || User.IsInRole("SupportStaff");
}

<!doctype html>
<html lang="en"
      class="layout-menu-fixed layout-compact"
      data-assets-path="~/sneat/assets/"
      data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@ViewData["Title"] - Male Fashion Admin</title>

    <meta name="description" content="Male Fashion Administration Dashboard" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/sneat/assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/sneat/assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="~/sneat/assets/vendor/fonts/iconify-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/sneat/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/sneat/assets/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="~/sneat/assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="~/sneat/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/sneat/assets/vendor/libs/apex-charts/apex-charts.css" />

    <!-- Helpers -->
    <script src="~/sneat/assets/vendor/js/helpers.js"></script>
    <script>
        if (window.Helpers) {
            window.Helpers.initPasswordToggle = function () { };
        }
    </script>
    <script src="~/sneat/assets/js/config.js"></script>

    <style>
        input::-ms-reveal,
        input::-ms-clear {
            display: none;
        }
        .form-password-toggle .input-group-text {
            cursor: pointer;
            user-select: none;
        }

        /* Ensure SweetAlert2 toast floats above navbar and clears the top detached search bar */
        .swal2-container {
            z-index: 10000 !important;
        }
        .swal2-container.swal2-top-end {
            top: 78px !important;
            right: 25px !important;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu / Sidebar -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="app-brand-link">
                        <span class="app-brand-logo demo">
                            <span class="text-primary">
                                <svg width="25" viewBox="0 0 25 42" version="1.1" xmlns="http://www.w3.org/2000/svg">
                                    <defs>
                                        <path d="M13.7918663,0.358365126 L3.39788168,7.44174259 C0.566865006,9.69408886 -0.379795268,12.4788597 0.557900856,15.7960551 C0.68998853,16.2305145 1.09562888,17.7872135 3.12357076,19.2293357 C3.8146334,19.7207684 5.32369333,20.3834223 7.65075054,21.2172976 L7.59773219,21.2525164 L2.63468769,24.5493413 C0.445452254,26.3002124 0.0884951797,28.5083815 1.56381646,31.1738486 C2.83770406,32.8170431 5.20850219,33.2640127 7.09180128,32.5391577 C8.347334,32.0559211 11.4559176,30.0011079 16.4175519,26.3747182 C18.0338572,24.4997857 18.6973423,22.4544883 18.4080071,20.2388261 C17.963753,17.5346866 16.1776345,15.5799961 13.0496516,14.3747546 L10.9194936,13.4715819 L18.6192054,7.984237 L13.7918663,0.358365126 Z" id="path-1"></path>
                                        <path d="M5.47320593,6.00457225 C4.05321814,8.216144 4.36334763,10.0722806 6.40359441,11.5729822 C8.61520715,12.571656 10.0999176,13.2171421 10.8577257,13.5094407 L15.5088241,14.433041 L18.6192054,7.984237 C15.5364148,3.11535317 13.9273018,0.573395879 13.7918663,0.358365126 C13.5790555,0.511491653 10.8061687,2.3935607 5.47320593,6.00457225 Z" id="path-3"></path>
                                        <path d="M7.50063644,21.2294429 L12.3234468,23.3159332 C14.1688022,24.7579751 14.397098,26.4880487 13.008334,28.506154 C11.6195701,30.5242593 10.3099883,31.790241 9.07958868,32.3040991 C5.78142938,33.4346997 4.13234973,34 4.13234973,34 C4.13234973,34 2.75489982,33.0538207 2.37032616e-14,31.1614621 C-0.55822714,27.8186216 -0.55822714,26.0572515 -4.05231404e-15,25.8773518 C0.83734071,25.6075023 2.77988457,22.8248993 3.3049379,22.52991 C3.65497346,22.3332504 5.05353963,21.8997614 7.50063644,21.2294429 Z" id="path-4"></path>
                                        <path d="M20.6,7.13333333 L25.6,13.8 C26.2627417,14.6836556 26.0836556,15.9372583 25.2,16.6 C24.8538077,16.8596443 24.4327404,17 24,17 L14,17 C12.8954305,17 12,16.1045695 12,15 C12,14.5672596 12.1403557,14.1461923 12.4,13.8 L17.4,7.13333333 C18.0627417,6.24967773 19.3163444,6.07059163 20.2,6.73333333 C20.3516113,6.84704183 20.4862915,6.981722 20.6,7.13333333 Z" id="path-5"></path>
                                    </defs>
                                    <g id="g-app-brand" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <g id="Brand-Logo" transform="translate(-27.000000, -15.000000)">
                                            <g id="Icon" transform="translate(27.000000, 15.000000)">
                                                <g id="Mask" transform="translate(0.000000, 8.000000)">
                                                    <mask id="mask-2" fill="white">
                                                        <use xlink:href="#path-1"></use>
                                                    </mask>
                                                    <use fill="currentColor" xlink:href="#path-1"></use>
                                                    <g id="Path-3" mask="url(#mask-2)">
                                                        <use fill="currentColor" xlink:href="#path-3"></use>
                                                        <use fill-opacity="0.2" fill="#FFFFFF" xlink:href="#path-3"></use>
                                                    </g>
                                                    <g id="Path-4" mask="url(#mask-2)">
                                                        <use fill="currentColor" xlink:href="#path-4"></use>
                                                        <use fill-opacity="0.2" fill="#FFFFFF" xlink:href="#path-4"></use>
                                                    </g>
                                                </g>
                                                <g id="Triangle"
                                                   transform="translate(19.000000, 11.000000) rotate(-300.000000) translate(-19.000000, -11.000000) ">
                                                    <use fill="currentColor" xlink:href="#path-5"></use>
                                                    <use fill-opacity="0.2" fill="#FFFFFF" xlink:href="#path-5"></use>
                                                </g>
                                            </g>
                                        </g>
                                    </g>
                                </svg>
                            </span>
                        </span>
                        <span class="app-brand-text demo menu-text fw-bold ms-2">MF Admin</span>
                    </a>

                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="bx bx-chevron-left d-block d-xl-none align-middle"></i>
                    </a>
                </div>

                <div class="menu-divider mt-0"></div>
                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    <!-- ============================================== -->
                    <!-- 1. DASHBOARD -->
                    <!-- ============================================== -->
                    <li class="menu-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home-smile"></i>
                            <div class="text-truncate">Dashboard</div>
                        </a>
                    </li>

                    <!-- ============================================== -->
                    <!-- 2. CATALOG & PRODUCTS -->
                    <!-- ============================================== -->
                    @if (canManageCatalog)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Catalog & Products</span>
                        </li>

                        <li class="menu-item @(currentController == "Categories" || currentController == "Category" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-category"></i>
                                <div class="text-truncate">Categories</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Brands" || currentController == "Brand" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-badge-check"></i>
                                <div class="text-truncate">Brands</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Products" || currentController == "Product" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-package"></i>
                                <div class="text-truncate">Products</div>
                            </a>
                        </li>
                    }

                    <!-- ============================================== -->
                    <!-- 3. SALES & SHOPPING -->
                    <!-- ============================================== -->
                    @if (canManageOrders)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Sales & Orders</span>
                        </li>

                        <li class="menu-item @(currentController == "Orders" || currentController == "Order" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-shopping-bag"></i>
                                <div class="text-truncate">Orders</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Carts" || currentController == "Cart" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Carts" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-cart"></i>
                                <div class="text-truncate">Active Carts</div>
                            </a>
                        </li>

                        <!-- ============================================== -->
                        <!-- 4. CUSTOMERS -->
                        <!-- ============================================== -->
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Customer Management</span>
                        </li>

                        <li class="menu-item @(currentController == "Customers" || currentController == "Customer" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-user"></i>
                                <div class="text-truncate">Customers</div>
                            </a>
                        </li>
                    }

                    <!-- ============================================== -->
                    <!-- 5. PROMOTIONS & MARKETING -->
                    <!-- ============================================== -->
                    @if (canManageCatalog || canManageSupport)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Promotions & Marketing</span>
                        </li>

                        <li class="menu-item @(currentController == "Coupons" || currentController == "Coupon" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Coupons" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-purchase-tag"></i>
                                <div class="text-truncate">Coupons & Discounts</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "DealCountdowns" || currentController == "DealCountdown" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="DealCountdowns" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-timer"></i>
                                <div class="text-truncate">Flash Deals</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Newsletters" || currentController == "NewsletterSubscriber" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Newsletters" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-envelope"></i>
                                <div class="text-truncate">Newsletter Subscribers</div>
                            </a>
                        </li>
                    }

                    <!-- ============================================== -->
                    <!-- 6. CONTENT & BLOG -->
                    <!-- ============================================== -->
                    @if (canManageBlog)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Blog & Articles</span>
                        </li>

                        <li class="menu-item @(currentController == "BlogPosts" || currentController == "BlogPost" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-news"></i>
                                <div class="text-truncate">Blog Posts</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "BlogComments" || currentController == "BlogComment" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="BlogComments" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-comment-detail"></i>
                                <div class="text-truncate">Comments Moderation</div>
                            </a>
                        </li>

                        <!-- ============================================== -->
                        <!-- 8. WEBSITE CMS -->
                        <!-- ============================================== -->
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Website CMS</span>
                        </li>

                        <li class="menu-item @(currentController == "HeroSlides" || currentController == "HeroSlide" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="HeroSlides" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-slideshow"></i>
                                <div class="text-truncate">Hero Slides</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "TeamMembers" || currentController == "TeamMember" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="TeamMembers" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-group"></i>
                                <div class="text-truncate">Team Members</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Partners" || currentController == "PartnerClient" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Partners" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-briefcase-alt"></i>
                                <div class="text-truncate">Partner Clients</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Testimonials" || currentController == "Testimonial" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Testimonials" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-quote-right"></i>
                                <div class="text-truncate">Testimonials</div>
                            </a>
                        </li>
                    }

                    <!-- ============================================== -->
                    <!-- 7. FEEDBACK & SUPPORT -->
                    <!-- ============================================== -->
                    @if (canManageSupport)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Feedback & Support</span>
                        </li>

                        <li class="menu-item @(currentController == "Reviews" || currentController == "ProductReview" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-star"></i>
                                <div class="text-truncate">Product Reviews</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "ContactInquiries" || currentController == "ContactInquiry" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="ContactInquiries" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-support"></i>
                                <div class="text-truncate">Contact Messages</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "StoreLocations" || currentController == "StoreLocation" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="StoreLocations" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-map-pin"></i>
                                <div class="text-truncate">Store Locations</div>
                            </a>
                        </li>
                    }

                    <!-- ============================================== -->
                    <!-- 9. SECURITY & ACCESS -->
                    <!-- ============================================== -->
                    @if (isSuperOrAdmin)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Security & Access</span>
                        </li>

                        <li class="menu-item @(currentController == "Users" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-id-card"></i>
                                <div class="text-truncate">Staff Management</div>
                            </a>
                        </li>

                        <li class="menu-item @(currentController == "Roles" ? "active" : "")">
                            <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-shield-quarter"></i>
                                <div class="text-truncate">Role Management</div>
                            </a>
                        </li>
                    }

                    <!-- ============================================== -->
                    <!-- 10. SETTINGS & ACCOUNT -->
                    <!-- ============================================== -->
                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">Settings</span>
                    </li>

                    <li class="menu-item @(currentController == "Account" && currentAction == "ChangePassword" ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-key"></i>
                            <div class="text-truncate">Change Password</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="menu-link" target="_blank">
                            <i class="menu-icon tf-icons bx bx-store-alt"></i>
                            <div class="text-truncate">Visit Storefront</div>
                        </a>
                    </li>
                </ul>
            </aside>
            <!-- / Menu -->
            <!-- Layout container -->
            <div class="layout-page">
                <!-- Top Navbar -->
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
                     id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <!-- Search Bar -->
                        <div class="navbar-nav align-items-center me-auto">
                            <div class="nav-item d-flex align-items-center">
                                <span class="w-px-22 h-px-22"><i class="icon-base bx bx-search icon-md"></i></span>
                                <input type="text"
                                       class="form-control border-0 shadow-none ps-1 ps-sm-2 d-md-block d-none"
                                       placeholder="Search..."
                                       aria-label="Search..." />
                            </div>
                        </div>

                        <!-- Right Profile Navigation -->
                        <ul class="navbar-nav flex-row align-items-center ms-md-auto">
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    var currentUser = await UserManager.GetUserAsync(User);
                                    var fullName = currentUser != null
                                        ? $"{currentUser.FirstName} {currentUser.LastName}".Trim()
                                        : User.Identity?.Name;
                                    var displayEmail = currentUser?.Email ?? User.Identity?.Name;

                                    <a class="nav-link dropdown-toggle hide-arrow p-0"
                                       href="javascript:void(0);"
                                       data-bs-toggle="dropdown">
                                        <div class="avatar avatar-online">
                                            <img src="~/sneat/assets/img/avatars/1.png" alt="Admin Avatar" class="w-px-40 h-auto rounded-circle" />
                                        </div>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <div class="dropdown-item">
                                                <div class="d-flex">
                                                    <div class="flex-shrink-0 me-3">
                                                        <div class="avatar avatar-online">
                                                            <img src="~/sneat/assets/img/avatars/1.png" alt="Admin Avatar" class="w-px-40 h-auto rounded-circle" />
                                                        </div>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@fullName</h6>
                                                        <small class="text-body-secondary text-truncate d-block" style="max-width: 150px;">@displayEmail</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                        <li>
                                            <div class="dropdown-divider my-1"></div>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                                <i class="icon-base bx bx-store icon-md me-3"></i><span>Storefront</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Account" asp-action="ChangePassword">
                                                <i class="icon-base bx bx-key icon-md me-3"></i><span>Change Password</span>
                                            </a>
                                        </li>
                                        <li>
                                            <div class="dropdown-divider my-1"></div>
                                        </li>
                                        <li>
                                            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Login", "Account", new { area = "Admin" })" method="post" class="m-0 p-0">
                                                <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                                    <i class="icon-base bx bx-power-off icon-md me-3"></i><span>Log Out</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-primary" asp-area="Admin" asp-controller="Account" asp-action="Login">
                                        <i class="bx bx-log-in me-1"></i> Sign In
                                    </a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
                <!-- / Top Navbar -->
                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <!-- Dynamic Body Content -->
                    <div class="container-xxl flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>

                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl">
                            <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
                                <div class="mb-2 mb-md-0">
                                    © @DateTime.Now.Year Male Fashion Portal. All rights reserved.
                                </div>
                                <div class="d-none d-lg-inline-block">
