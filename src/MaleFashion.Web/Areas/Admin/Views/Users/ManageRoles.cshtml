@model MaleFashion.Web.Areas.Admin.Models.Security.UserRoleAssignmentModel

@{
    ViewData["Title"] = "Manage Staff Roles";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                    <div>
                        <h5 class="mb-0">Manage Roles for Staff Member</h5>
                        <small class="text-muted">Assign or revoke operational access roles for this employee</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to Staff List
                    </a>
                </div>
                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    <!-- User Information Summary Box -->
                    <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
                        <i class="bx bx-user-circle fs-3 me-3"></i>
                        <div>
                            <h6 class="alert-heading mb-1"><strong>@Model.FullName</strong> (@Model.UserName)</h6>
                            <p class="mb-0 small">Email: <strong>@Model.Email</strong></p>
                        </div>
                    </div>

                    <form asp-action="ManageRoles" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="FullName" />

                        <h6 class="fw-semibold mb-3">Available Roles</h6>

                        <div class="list-group mb-4">
                            @for (int i = 0; i < Model.Roles.Count; i++)
                            {
                                <input type="hidden" asp-for="@Model.Roles[i].RoleId" />
                                <input type="hidden" asp-for="@Model.Roles[i].RoleName" />

                                <label class="list-group-item d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <input class="form-check-input me-3"
                                               type="checkbox"
                                               asp-for="@Model.Roles[i].IsSelected"
                                               disabled="@(Model.Roles[i].IsDisabled ? "disabled" : null)" />
                                        <div>
                                            <strong>@Model.Roles[i].RoleName</strong>
                                            @if (Model.Roles[i].RoleName == "Admin")
                                            {
                                                <span class="badge bg-label-danger ms-2">Full Administrator Access</span>
                                            }
                                            else if (Model.Roles[i].RoleName == "Customer")
                                            {
                                                <span class="badge bg-label-success ms-2">Standard Shopper</span>
                                            }
                                        </div>
                                    </div>
                                    @if (Model.Roles[i].IsDisabled)
                                    {
                                        <input type="hidden" asp-for="@Model.Roles[i].IsSelected" value="true" />
                                        <span class="badge bg-label-warning"><i class="bx bx-shield me-1"></i>Cannot Remove Own Admin Role</span>
                                    }
                                </label>
                            }
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Save Role Assignments
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

