@model List<MaleFashion.Web.Models.Account.Manage.CustomerOrderSummaryViewModel>
@{
    ViewData["Title"] = "My Orders";
    ViewData["ActiveMenu"] = "MyOrders";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">My Orders</h4>
                            <small class="text-muted">Track your shipments and review previous purchase invoices</small>
                        </div>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Dashboard
                        </a>
                    </div>

                    <!-- Status Filter Tabs -->
                    <div class="order-filter-nav mb-4">
                        <ul class="nav nav-pills flex-nowrap overflow-auto py-1">
                            <li class="nav-item">
                                <a asp-action="Orders" class="nav-link py-1 px-3 small font-weight-bold @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">All</a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Orders" asp-route-status="pending" class="nav-link py-1 px-3 small font-weight-bold @(currentStatus == "pending" ? "active" : "")">Pending</a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Orders" asp-route-status="processing" class="nav-link py-1 px-3 small font-weight-bold @(currentStatus == "processing" ? "active" : "")">Processing</a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Orders" asp-route-status="shipped" class="nav-link py-1 px-3 small font-weight-bold @(currentStatus == "shipped" ? "active" : "")">Shipped</a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Orders" asp-route-status="delivered" class="nav-link py-1 px-3 small font-weight-bold @(currentStatus == "delivered" ? "active" : "")">Delivered</a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Orders" asp-route-status="cancelled" class="nav-link py-1 px-3 small font-weight-bold @(currentStatus == "cancelled" ? "active" : "")">Cancelled</a>
                            </li>
                        </ul>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="orders-list">
                            @foreach (var order in Model)
                            {
                                <div class="order-item-card border rounded p-3 mb-3 shadow-sm bg-white">
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                        <div>
                                            <strong class="text-dark font-weight-bold">Order #@order.OrderNumber</strong>
                                            <span class="text-muted small ml-2"><i class="fa fa-calendar-o mr-1"></i> @order.OrderDate.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                        </div>
                                        <div>
                                            @if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Delivered)
                                            {
                                                <span class="badge badge-success px-2 py-1">Delivered</span>
                                            }
                                            else if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Shipped)
                                            {
                                                <span class="badge badge-info px-2 py-1">Shipped</span>
                                            }
                                            else if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Processing)
                                            {
                                                <span class="badge badge-primary px-2 py-1">Processing</span>
                                            }
                                            else if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Cancelled)
                                            {
                                                <span class="badge badge-danger px-2 py-1">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning px-2 py-1">Pending</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2">
                                        <div>
                                            <p class="mb-1 text-dark small font-weight-bold">
                                                @order.TotalItems item(s): <span class="font-weight-normal text-muted">@string.Join(", ", order.ItemNames)</span>
                                            </p>
                                            <small class="text-muted">
                                                Payment: <span class="badge badge-light border">@order.PaymentStatus</span>
                                            </small>
                                        </div>
                                        <div class="text-right">
                                            <div class="h6 font-weight-bold text-dark mb-1">৳ @order.TotalAmount.ToString("N2")</div>
                                            <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-xs btn-outline-danger font-weight-bold py-1 px-3" style="font-size: 12px;">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-shopping-bag fa-3x text-muted mb-3 d-block"></i>
                            <h6 class="font-weight-bold text-dark">No Orders Found</h6>
                            <p class="text-muted small">You haven't placed any orders under this filter.</p>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-danger font-weight-bold" style="background-color: #e53637; border-color: #e53637;">
                                Browse Storefront
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card, .order-item-card {
        border-radius: 4px;
    }

    .order-filter-nav .nav-link {
        color: #555;
        border-radius: 20px;
        margin-right: 6px;
    }

    .order-filter-nav .nav-link.active {
        background-color: #e53637 !important;
        color: #fff !important;
    }
</style>

