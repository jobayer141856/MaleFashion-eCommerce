@model MaleFashion.Application.Features.Home.DTOs.HomePageOverviewDto
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section Begin -->
<section class="hero">
    <div class="hero__slider owl-carousel">
        @foreach (var slide in Model.HeroSlides)
        {
            <div class="hero__items set-bg" data-setbg="@Url.Content(slide.ImageUrl)">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-5 col-lg-7 col-md-8">
                            <div class="hero__text">
                                <h6>@slide.Subtitle</h6>
                                <h2>@slide.Title</h2>
                                <p>@slide.Description</p>
                                <a href="@slide.TargetUrl" class="primary-btn">@slide.ButtonText <span class="arrow_right"></span></a>
                                <div class="hero__social">
                                    <a href="#" target="_blank" rel="noopener"><i class="fa fa-facebook"></i></a>
                                    <a href="#" target="_blank" rel="noopener"><i class="fa fa-twitter"></i></a>
                                    <a href="#" target="_blank" rel="noopener"><i class="fa fa-pinterest"></i></a>
                                    <a href="#" target="_blank" rel="noopener"><i class="fa fa-instagram"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
<!-- Hero Section End -->

<!-- Banner Section Begin -->
<section class="banner spad">
    <div class="container">
        <div class="row">
            @foreach (var banner in Model.Banners)
            {
                <div class="@banner.ColumnClass">
                    <div class="banner__item @banner.CssModifier">
                        <div class="banner__item__pic">
                            <img src="@Url.Content(banner.ImageUrl)" alt="@banner.Title" />
                        </div>
                        <div class="banner__item__text">
                            <h2>@banner.Title</h2>
                            <a href="@banner.TargetUrl">Shop now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Banner Section End -->

<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <ul class="filter__controls">
                    <li class="active" data-filter="*">Best Sellers</li>
                    <li data-filter=".new-arrivals">New Arrivals</li>
                    <li data-filter=".hot-sales">Hot Sales</li>
                </ul>
            </div>
        </div>
        <div class="row product__filter">
            @foreach (var product in Model.FeaturedProducts)
            {
                var labelClass = product.HasDiscount ? "sale" : "";

                <div class="col-lg-3 col-md-6 col-sm-6 @product.MixItUpClasses">
                    <div class="product__item @labelClass">
                        <div class="product__item__pic set-bg" data-setbg="@Url.Content(product.PrimaryImageUrl)">
                            @if (product.HasDiscount)
                            {
                                <span class="label">Sale</span>
                            }
                            else if (product.IsNewArrival)
                            {
                                <span class="label">New</span>
                            }
                            <ul class="product__hover">
                                <li>
                                    <a href="javascript:void(0);" class="btn-add-wishlist" data-product-id="@product.Id" data-product-name="@product.Name" title="Add to Wishlist">
                                        <img src="@Url.Content("~/malefashion/img/icon/heart.png")" alt="Wishlist" />
                                    </a>
                                </li>
                                <li>
                                    <a href="javascript:void(0);" class="btn-compare" title="Compare">
                                        <img src="@Url.Content("~/malefashion/img/icon/compare.png")" alt="Compare" />
                                        <span>Compare</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" title="View Details">
                                        <img src="@Url.Content("~/malefashion/img/icon/search.png")" alt="Details" />
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6>@product.Name</h6>
                            <a href="javascript:void(0);" class="add-cart btn-add-cart" data-product-id="@product.Id" data-product-name="@product.Name">+ Add To Cart</a>
                            <div class="rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (product.Rating >= i)
                                    {
                                        <i class="fa fa-star text-warning"></i>
                                    }
                                    else if (product.Rating >= (i - 0.5))
                                    {
                                        <i class="fa fa-star-half-o text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-star-o"></i>
                                    }
                                }
                            </div>
                            <h5>
                                $@product.DisplayPrice.ToString("0.00")
                                @if (product.HasDiscount)
                                {
                                    <span class="text-muted small ml-1" style="text-decoration: line-through; font-size: 13px; font-weight: normal;">
                                        $@product.BasePrice.ToString("0.00")
                                    </span>
                                }
                            </h5>
                            @if (product.AvailableColors.Count > 0)
                            {
                                <div class="product__color__select">
                                    @for (int cIndex = 0; cIndex < product.AvailableColors.Count; cIndex++)
                                    {
                                        var colorHex = product.AvailableColors[cIndex];
                                        var inputId = $"pc-{product.Id.ToString().Substring(0, 8)}-{cIndex}";
                                        <label for="@inputId" class="@(cIndex == 0 ? "active" : "")" style="background-color: @colorHex; border: 1px solid #ddd;">
                                            <input type="radio" id="@inputId" name="color-@product.Id" />
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Product Section End -->

<!-- Categories Section Begin -->
<section class="categories spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="categories__text">
                    <h2>Clothings Hot <br /> <span>Shoe Collection</span> <br /> Accessories</h2>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="categories__hot__deal">
                    <img src="@Url.Content(Model.DealOfTheWeek.ImageUrl)" alt="@Model.DealOfTheWeek.Title" />
                    <div class="hot__deal__sticker">
                        <span>Sale Of</span>
                        <h5>$@Model.DealOfTheWeek.SalePrice.ToString("0.00")</h5>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 offset-lg-1">
                <div class="categories__deal__countdown">
                    <span>@Model.DealOfTheWeek.SectionHeading</span>
                    <h2>@Model.DealOfTheWeek.Title</h2>
                    <div class="categories__deal__countdown__timer" id="countdown" data-countdown="@Model.DealOfTheWeek.EndDate.ToString("yyyy/MM/dd HH:mm:ss")">
                        <div class="cd-item">
                            <span>0</span>
                            <p>Days</p>
                        </div>
                        <div class="cd-item">
                            <span>0</span>
                            <p>Hours</p>
                        </div>
                        <div class="cd-item">
                            <span>0</span>
                            <p>Minutes</p>
                        </div>
                        <div class="cd-item">
                            <span>0</span>
                            <p>Seconds</p>
                        </div>
                    </div>
                    <a href="@Model.DealOfTheWeek.TargetUrl" class="primary-btn">Shop now</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Categories Section End -->

<!-- Instagram Section Begin -->
<section class="instagram spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="instagram__pic">
                    @foreach (var insta in Model.InstagramPosts)
                    {
                        <div class="instagram__pic__item set-bg" data-setbg="@Url.Content(insta.ImageUrl)">
                            <a href="@insta.TargetUrl" style="display: block; width: 100%; height: 100%;"></a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="instagram__text">
                    <h2>Instagram</h2>
                    <p>
                        Explore trendsetting styles, behind-the-scenes designs, and seasonal highlights from our community.
                    </p>
                    <h3>#Male_Fashion</h3>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Instagram Section End -->

<!-- Latest Blog Section Begin -->
<section class="latest spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Latest News</span>
                    <h2>Fashion New Trends</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var blog in Model.LatestBlogs)
            {
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="blog__item">
                        <div class="blog__item__pic set-bg" data-setbg="@Url.Content(blog.ImageUrl)"></div>
                        <div class="blog__item__text">
                            <span><img src="@Url.Content("~/malefashion/img/icon/calendar.png")" alt="" /> @blog.PublishedDate.ToString("dd MMMM yyyy")</span>
                            <h5>@blog.Title</h5>
                            <a href="@blog.TargetUrl">Read More</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Latest Blog Section End -->

@section Scripts {
    <script>
        $(function () {
            // 1. Dynamic Countdown Timer
            var $countdown = $("#countdown");
            if ($countdown.length > 0) {
                var targetDate = $countdown.data("countdown");
                if (targetDate) {
                    $countdown.countdown(targetDate, function (event) {
                        $(this).html(
                            event.strftime(
                                "<div class='cd-item'><span>%D</span> <p>Days</p> </div>" +
                                "<div class='cd-item'><span>%H</span> <p>Hours</p> </div>" +
                                "<div class='cd-item'><span>%M</span> <p>Minutes</p> </div>" +
                                "<div class='cd-item'><span>%S</span> <p>Seconds</p> </div>"
                            )
                        );
                    });
                }
            }

            // 2. Interactive Quick Wishlist Feedback
            $(document).on("click", ".btn-add-wishlist", function (e) {
                e.preventDefault();
                var productName = $(this).data("product-name") || "Item";
                Swal.fire({
                    icon: 'success',
                    title: 'Added to Wishlist!',
                    text: productName + ' has been saved to your wishlist.',
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            });

            // 3. Interactive Quick Add to Cart Feedback
            $(document).on("click", ".btn-add-cart", function (e) {
                e.preventDefault();
                var productName = $(this).data("product-name") || "Item";
                Swal.fire({
                    icon: 'success',
                    title: 'Added to Cart!',
                    text: productName + ' was added to your cart.',
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            });

            // 4. Compare feature notification
            $(document).on("click", ".btn-compare", function (e) {
                e.preventDefault();
                Swal.fire({
                    icon: 'info',
                    title: 'Compare',
                    text: 'Product comparison feature will be available soon!',
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            });
        });
    </script>
}
<!-- Latest Blog Section End -->