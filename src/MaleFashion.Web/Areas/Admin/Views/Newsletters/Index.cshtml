@{
    ViewData["Title"] = "Newsletter Subscribers";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">
}

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Stat Cards Overview -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card card-border-shadow-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-envelope"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.TotalSubscribers ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Total Subscribers</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card card-border-shadow-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-circle"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.ActiveSubscribers ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Active Subscribers</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card card-border-shadow-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-user-x"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.InactiveSubscribers ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Unsubscribed / Inactive</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Subscribers Table Card -->
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Newsletter Subscribers</h5>
                </div>
                <div class="card-body table-responsive pt-0">
                    <partial name="_ModalPartial" />
                    <table id="newsletters-table" class="table table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th>Email Address</th>
                                <th>Subscribed At</th>
                                <th style="width: 110px;">Status</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Toggle Form -->
<form id="toggle-form" action="/Admin/Newsletters/ToggleStatus" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="toggle-id" name="id" />
</form>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function() {
            var table = $("#newsletters-table").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                order: [[1, 'desc']],
                ajax: {
                    url: "/Admin/Newsletters/GetPagedNewsletters",
                    type: "POST",
                    contentType: "application/json",
                    data: d => JSON.stringify(d)
                },
                columnDefs: [
                    {
                        targets: 2,
                        render: function(data) {
                            return data === "Active"
                                ? '<span class="badge bg-label-success">Active</span>'
                                : '<span class="badge bg-label-secondary">Inactive</span>';
                        }
                    },
                    {
                        orderable: false,
                        targets: -1,
                        render: function(data, type, row) {
                            var status = row[2];
                            var toggleText = status === "Active" ? "Deactivate" : "Activate";
                            var toggleIcon = status === "Active" ? "bx-block text-warning" : "bx-check-circle text-success";

                            return `
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <button class="dropdown-item toggle-btn" data-id="${data}">
                                                <i class="bx ${toggleIcon} me-1"></i> ${toggleText}
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger show-bs-modal" data-id="${data}">
                                                <i class="bx bx-trash me-1"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>`;
                        }
                    }
                ]
            });

            // Status Toggle Handler
            $("#newsletters-table").on('click', '.toggle-btn', function() {
                var id = $(this).data('id');
                $('#toggle-id').val(id);
                $('#toggle-form').submit();
            });

            // Delete Modal Handler
            $("#newsletters-table").on('click', '.show-bs-modal', function() {
                var id = $(this).data('id');
                var deleteModal = $("#delete-modal");
                deleteModal.find('#modelLabel').text("Delete Subscriber");
                deleteModal.find('.modal-body p').html('Are you sure you want to delete this newsletter subscriber?');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/Admin/Newsletters/Delete');
                deleteModal.modal('show');
            });

            $('#delete-btn').on('click', function() {
                $('#delete-form').submit();
            });
        });
    </script>
}

