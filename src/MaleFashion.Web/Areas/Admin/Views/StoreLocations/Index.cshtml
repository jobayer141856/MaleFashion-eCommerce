@{
    ViewData["Title"] = "Store Locations";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Store & Office Locations</h5>
                    <a asp-area="Admin" asp-controller="StoreLocations" asp-action="Create" class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i> Add Location
                    </a>
                </div>
                <div class="card-body table-responsive pt-0">
                    <partial name="_ModalPartial" />
                    <table id="locations-table" class="table table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th>Location / Country</th>
                                <th>Address</th>
                                <th>Phone Number</th>
                                <th style="width: 110px;">Order</th>
                                <th style="width: 90px;">Status</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function() {
            $("#locations-table").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/Admin/StoreLocations/GetPagedStoreLocations",
                    type: "POST",
                    contentType: "application/json",
                    data: d => JSON.stringify(d)
                },
                columnDefs: [
                    {
                        targets: 4,
                        render: data => data === "Active"
                            ? `<span class="badge bg-label-success">Active</span>`
                            : `<span class="badge bg-label-secondary">Inactive</span>`
                    },
                    {
                        orderable: false,
                        targets: -1,
                        render: data => `
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item text-warning" href="/Admin/StoreLocations/Update/${data}"><i class="bx bx-edit-alt me-1"></i> Edit</a></li>
                                    <li><button class="dropdown-item text-danger show-bs-modal" data-id="${data}"><i class="bx bx-trash me-1"></i> Delete</button></li>
                                </ul>
                            </div>`
                    }
                ]
            });

            $("#locations-table").on('click', '.show-bs-modal', function() {
                let id = $(this).data('id');
                let deleteModal = $("#delete-modal");
                deleteModal.find('#modelLabel').text("Delete Location");
                deleteModal.find('.modal-body p').html('Are you sure you want to delete this store location?');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/admin/storelocations/delete');
                deleteModal.modal('show');
            });

            $('#delete-btn').on('click', () => $('#delete-form').submit());
        });
    </script>
}

