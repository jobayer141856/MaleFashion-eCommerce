@model MaleFashion.Web.Models.Account.Manage.CustomerEditProfileModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["ActiveMenu"] = "MyProfile";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">My Profile</h4>
                            <small class="text-muted">Manage and update your personal information</small>
                        </div>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Back to Dashboard
                        </a>
                    </div>

                    <form asp-action="EditProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="font-weight-bold small text-dark"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="font-weight-bold small text-dark"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="font-weight-bold small text-dark"></label>
                                <div class="input-group">
                                    <input asp-for="Email" class="form-control bg-light" readonly />
                                    <div class="input-group-append">
                                        <span class="input-group-text small bg-light">
                                            @if (Model.IsEmailConfirmed)
                                            {
                                                <span class="text-success font-weight-bold"><i class="fa fa-check-circle"></i> Verified</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning font-weight-bold"><i class="fa fa-clock-o"></i> Unverified</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                                <small class="text-muted">Login email address cannot be changed directly.</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="font-weight-bold small text-dark"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +880 1700-000000" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DateOfBirth" class="font-weight-bold small text-dark"></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3 clearfix">
                                <label asp-for="Gender" class="font-weight-bold small text-dark d-block mb-1"></label>
                                <select asp-for="Gender" class="form-control w-100" style="width: 100% !important;">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-danger font-weight-bold px-4 py-2" style="background-color: #e53637; border-color: #e53637;">
                                <i class="fa fa-save mr-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card {
        border-radius: 4px;
        border: 1px solid #f0f0f0;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

