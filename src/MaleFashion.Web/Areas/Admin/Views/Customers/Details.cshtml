@model CustomerDetailsModel

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <!-- Customer Profile Sidebar -->
        <div class="col-xl-4 col-lg-5 col-md-5">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="user-avatar-section text-center mb-3">
                        <div class="d-flex flex-column align-items-center">
                            <div class="avatar avatar-xl mb-3">
                                <span class="avatar-initial rounded-circle bg-label-primary fs-2">
                                    @Model.FullName.Substring(0, 1).ToUpper()
                                </span>
                            </div>
                            <div class="user-info text-center">
                                <h4 class="mb-1">@Model.FullName</h4>
                                @switch (Model.Origin)
                                {
                                    case MaleFashion.Domain.Enums.CustomerOrigin.Guest:
                                        <span class="badge bg-label-secondary"><i class="bx bx-user me-1"></i>Guest</span>
                                        break;
                                    case MaleFashion.Domain.Enums.CustomerOrigin.Admin:
                                        <span class="badge bg-label-warning"><i class="bx bx-shield-quarter me-1"></i>Admin Created</span>
                                        break;
                                    default:
                                        <span class="badge bg-label-success"><i class="bx bx-check-shield me-1"></i>Self Registered</span>
                                        break;
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-around flex-wrap my-4 py-2 border-top border-bottom">
                        <div class="d-flex align-items-center me-4 mt-2">
                            <div class="avatar me-2">
                                <div class="avatar-initial bg-label-primary rounded">
                                    <i class="bx bx-shopping-bag fs-4"></i>
                                </div>
                            </div>
                            <div>
                                <h5 class="mb-0">@Model.TotalOrders</h5>
                                <span>Orders</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mt-2">
                            <div class="avatar me-2">
                                <div class="avatar-initial bg-label-success rounded">
                                    <i class="bx bx-dollar fs-4"></i>
                                </div>
                            </div>
                            <div>
                                <h5 class="mb-0">৳@Model.TotalSpent.ToString("N2")</h5>
                                <span>Spent</span>
                            </div>
                        </div>
                    </div>
                    <h5 class="pb-2 border-bottom mb-3">Details</h5>
                    <div class="info-container">
                        <ul class="list-unstyled">
                            <li class="mb-3">
                                <span class="fw-bold me-2">Email:</span>
                                <span>@Model.Email</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-bold me-2">Phone:</span>
                                <span>@Model.PhoneNumber</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-bold me-2">Gender:</span>
                                <span>@Model.Gender</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-bold me-2">Date of Birth:</span>
                                <span>@(Model.DateOfBirth?.ToString("MMM dd, yyyy") ?? "N/A")</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-bold me-2">Account ID:</span>
                                <span class="text-muted small">@(Model.UserId?.ToString() ?? "None (Guest)")</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-bold me-2">Joined:</span>
                                <span>@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </li>
                        </ul>
                        <div class="d-flex justify-content-center pt-3">
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                <i class="bx bx-edit me-1"></i> Edit Profile
                            </a>
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="btn btn-outline-secondary">Back</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Saved Addresses & Recent Orders Column -->
        <div class="col-xl-8 col-lg-7 col-md-7">
            <!-- Saved Addresses -->
            <div class="card mb-4">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">Saved Addresses</h5>
                </div>
                <div class="card-body pt-3">
                    @if (Model.Addresses.Any())
                    {
                        <div class="row g-3">
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3 position-relative">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="badge bg-label-info">@addr.Type</span>
                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge bg-label-success">Default</span>
                                            }
                                        </div>
                                        <p class="mb-0 text-muted">@addr.FullAddress</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No saved addresses for this customer.</p>
                    }
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="card mb-4">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">Recent Orders</h5>
                </div>
                <div class="card-body table-responsive pt-0">
                    @if (Model.RecentOrders.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td><strong>@order.OrderNumber</strong></td>
                                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-label-primary">@order.Status</span></td>
                                        <td><span class="badge bg-label-secondary">@order.PaymentStatus</span></td>
                                        <td>৳@order.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted pt-3 mb-0">This customer has not placed any orders yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>