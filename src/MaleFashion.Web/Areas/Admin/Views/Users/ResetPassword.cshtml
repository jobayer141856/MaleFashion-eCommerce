@model MaleFashion.Web.Areas.Admin.Models.Security.AdminResetUserPasswordModel

@{
    ViewData["Title"] = "Reset Staff Password";
}

@section Styles {
    <style>
        input::-ms-reveal,
        input::-ms-clear {
            display: none;
        }
        .form-password-toggle .input-group-text {
            cursor: pointer;
            user-select: none;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-7 col-lg-9 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom py-3">
                    <div>
                        <h5 class="card-title mb-0">
                            <i class="bx bx-key text-warning me-2"></i>Reset Staff Password
                        </h5>
                        <small class="text-muted">Directly override and reset credentials for this staff account</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to Staff List
                    </a>
                </div>

                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    <!-- User Identity Summary Card -->
                    <div class="card bg-label-secondary border-0 mb-4">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center">
                                <div class="avatar avatar-md me-3">
                                    <span class="avatar-initial rounded-circle bg-primary text-white">
                                        @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 text-heading fw-bold">@Model.FullName</h6>
                                    <div class="text-muted small">@Model.Email</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-label-primary">@Model.RolesSummary</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="ResetPassword" method="post" id="formResetPassword">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- New Password -->
                        <div class="mb-3 form-password-toggle">
                            <label class="form-label fw-semibold" asp-for="NewPassword"></label>
                            <div class="input-group input-group-merge">
                                <input class="form-control"
                                       asp-for="NewPassword"
                                       type="password"
                                       id="resetNewPassword"
                                       placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                       autocomplete="new-password"
                                       autofocus />
                                <span class="input-group-text cursor-pointer" data-toggle-target="resetNewPassword">
                                    <i class="bx bx-hide"></i>
                                </span>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="mb-4 form-password-toggle">
                            <label class="form-label fw-semibold" asp-for="ConfirmPassword"></label>
                            <div class="input-group input-group-merge">
                                <input class="form-control"
                                       asp-for="ConfirmPassword"
                                       type="password"
                                       id="resetConfirmPassword"
                                       placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                       autocomplete="new-password" />
                                <span class="input-group-text cursor-pointer" data-toggle-target="resetConfirmPassword">
                                    <i class="bx bx-hide"></i>
                                </span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Security Notice Card -->
                        <div class="alert alert-warning py-3 px-3 mb-4" role="alert">
                            <div class="d-flex">
                                <i class="bx bx-shield-quarter fs-4 me-2 mt-1"></i>
                                <div class="small">
                                    <strong>Important Security Notice:</strong>
                                    <p class="mb-0 mt-1">
                                        Resetting this password will immediately invalidate all existing active login sessions for <code>@Model.Email</code>.
                                        The user will be required to log in with this new password.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bx bx-check-shield me-1"></i> Reset Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

