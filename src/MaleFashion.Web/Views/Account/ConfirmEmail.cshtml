@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
}

<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Account Confirmation</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Confirm Email</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="checkout spad">
    <div class="container">
        <div class="checkout__form">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 8px; background: #ffffff;">

                        @if (Model.IsSuccess)
                        {
                            <div class="mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-success mb-3" style="width: 75px; height: 75px;">
                                    <i class="fa fa-check-circle" style="font-size: 40px;"></i>
                                </div>
                                <h3 class="font-weight-bold mb-2">Email Confirmed!</h3>
                                <p class="text-muted mb-4">@Model.StatusMessage</p>
                            </div>

                            <div>
                                <a asp-controller="Account" asp-action="Login" class="site-btn px-4 py-2">
                                    Sign In To Your Account
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-danger mb-3" style="width: 75px; height: 75px;">
                                    <i class="fa fa-times-circle" style="font-size: 40px;"></i>
                                </div>
                                <h3 class="font-weight-bold mb-2">Verification Failed</h3>
                                <p class="text-danger mb-4">@Model.StatusMessage</p>
                            </div>

                            <div class="border-top pt-3">
                                <a asp-controller="Account" asp-action="Login" class="site-btn px-4 py-2" style="background: #111111;">
                                    Go to Sign In
                                </a>
                            </div>
                        }

                        <div class="mt-4 pt-2">
                            <a asp-controller="Home" asp-action="Index" class="text-muted small">
                                <i class="fa fa-arrow-left me-1"></i> Back to Homepage
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>