{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=MaleFashion;User Id=YOUR_USER;Password=YOUR_PASSWORD;Trust Server Certificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true,
            "columnOptionsSection": {
              "addStandardColumns": [
                "LogEvent"
              ],
              "removeStandardColumns": [
                "Properties"
              ]
            }
          }
        }
      }
    ]
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 465,
    "Username": "your_email@example.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD_HERE",
    "FromName": "Male Fashion Support",
    "FromEmail": "support@example.com",
    "Timeout": 10000,
    "SmtpEncryption": "StartTls"
  },
  "SSLCommerz": {
    "StoreId": "YOUR_SSLCOMMERZ_STORE_ID",
    "StorePassword": "YOUR_SSLCOMMERZ_STORE_PASSWORD",
    "IsSandbox": true,
    "BaseUrl": "https://sandbox.sslcommerz.com"
  },
  "ReCaptcha": {
    "SiteKey": "YOUR_RECAPTCHA_V3_SITE_KEY",
    "SecretKey": "YOUR_RECAPTCHA_V3_SECRET_KEY",
    "MinimumScore": 0.5,
    "IsEnabled": false
  },
  "AllowedHosts": "*"
}