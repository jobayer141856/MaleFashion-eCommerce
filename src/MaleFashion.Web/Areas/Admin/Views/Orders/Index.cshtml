@{
    ViewData["Title"] = "Orders Management";
    var stats = ViewBag.Stats as MaleFashion.Application.Features.Ordering.DTOs.OrderStatsDto ?? new MaleFashion.Application.Features.Ordering.DTOs.OrderStatsDto();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="~/sneat/assets/vendor/libs/apex-charts/apex-charts.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Stat Cards Overview -->
    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-shopping-bag"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(stats.TotalOrders)</h4>
                    </div>
                    <p class="mb-0 text-muted">Total Orders</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-time-five"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0 text-warning">@(stats.PendingOrders)</h4>
                    </div>
                    <p class="mb-0 text-muted">Pending Orders</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-double"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0 text-success">@(stats.DeliveredOrders)</h4>
                    </div>
                    <p class="mb-0 text-muted">Delivered / Fulfilled</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-info h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-info"><i class="bx bx-dollar-circle"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">৳ @(stats.TotalSales.ToString("N2"))</h4>
                    </div>
                    <p class="mb-0 text-muted">Total Sales Revenue</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Analytics Row ("Order Charts") -->
    <div class="row mb-4">
        <!-- Chart 1: Fulfillment Status Breakdown -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div class="card-title mb-0">
                        <h5 class="m-0 me-2"><i class="bx bx-pie-chart-alt-2 me-1 text-primary"></i> Order Status Distribution</h5>
                        <small class="text-muted">Breakdown of orders by fulfillment stage</small>
                    </div>
                </div>
                <div class="card-body">
                    <div id="orderStatusChart" style="min-height: 250px;"></div>
                    <div class="d-flex justify-content-around text-center pt-2 border-top flex-wrap gap-2">
                        <div>
                            <span class="badge bg-label-warning mb-1">Pending</span>
                            <h6 class="mb-0 fw-bold">@(stats.PendingOrders)</h6>
                        </div>
                        <div>
                            <span class="badge bg-label-info mb-1">Processing</span>
                            <h6 class="mb-0 fw-bold">@(stats.ProcessingOrders)</h6>
                        </div>
                        <div>
                            <span class="badge bg-label-primary mb-1">Shipped</span>
                            <h6 class="mb-0 fw-bold">@(stats.ShippedOrders)</h6>
                        </div>
                        <div>
                            <span class="badge bg-label-success mb-1">Delivered</span>
                            <h6 class="mb-0 fw-bold">@(stats.DeliveredOrders)</h6>
                        </div>
                        <div>
                            <span class="badge bg-label-danger mb-1">Cancelled</span>
                            <h6 class="mb-0 fw-bold">@(stats.CancelledOrders)</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Revenue by Payment Method -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div class="card-title mb-0">
                        <h5 class="m-0 me-2"><i class="bx bx-bar-chart-alt-2 me-1 text-success"></i> Revenue by Payment Method</h5>
                        <small class="text-muted">Cash on Delivery vs Stripe gateway volume</small>
                    </div>
                </div>
                <div class="card-body">
                    <div id="paymentRevenueChart" style="min-height: 250px;"></div>
                    <div class="d-flex justify-content-around text-center pt-2 border-top">
                        <div>
                            <span class="badge bg-label-success mb-1"><i class="bx bx-money me-1"></i>Cash on Delivery</span>
                            <h6 class="mb-0 fw-bold">৳ @(stats.CashSales.ToString("N2"))</h6>
                        </div>
                        <div>
                            <span class="badge bg-label-primary mb-1"><i class="bx bxl-stripe me-1"></i>Stripe Online</span>
                            <h6 class="mb-0 fw-bold">৳ @(stats.StripeSales.ToString("N2"))</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Table Card -->
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h5 class="card-title mb-0">
                        <i class="bx bx-list-ul text-primary me-1"></i> Orders List
                    </h5>

                    <!-- Filter Toolbar -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <select id="filter-status" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Fulfillment Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Processing">Processing</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <select id="filter-payment-status" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Payment Statuses</option>
                            <option value="Paid">Paid</option>
                            <option value="Pending">Pending Payment</option>
                            <option value="Failed">Failed</option>
                            <option value="Refunded">Refunded</option>
                        </select>

                        <select id="filter-payment-method" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Methods</option>
                            <option value="Cash">Cash on Delivery</option>
                            <option value="Stripe">Stripe</option>
                        </select>
                    </div>
                </div>

                <div class="card-body table-responsive pt-3">
                    <partial name="_ModalPartial" />

                    <table id="orders-table" class="table table-bordered table-hover w-100 align-middle">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Items</th>
                                <th>Total Amount</th>
                                <th>Payment</th>
                                <th>Fulfillment</th>
                                <th style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Update Status Modal -->
<div class="modal fade" id="quickStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title"><i class="bx bx-sync me-1"></i> Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalOrderId" value="" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Fulfillment Status</label>
                    <select id="modalOrderStatusSelect" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="Processing">Processing</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveStatus" class="btn btn-primary">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/sneat/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            // ==============================================
            // 1. APEXCHARTS VISUALIZATION ("Order Charts")
            // ==============================================
            var pending = @(stats.PendingOrders);
            var processing = @(stats.ProcessingOrders);
            var shipped = @(stats.ShippedOrders);
            var delivered = @(stats.DeliveredOrders);
            var cancelled = @(stats.CancelledOrders);
            var totalOrders = @(stats.TotalOrders);

            var statusOptions = {
                chart: {
                    type: 'donut',
                    height: 240
                },
                labels: ['Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'],
                series: totalOrders > 0 ? [pending, processing, shipped, delivered, cancelled] : [0, 0, 0, 0, 0],
                colors: ['#ffab00', '#03c3ec', '#696cff', '#71dd37', '#ff3e1d'],
                legend: { position: 'bottom', fontSize: '11px' },
                dataLabels: {
                    enabled: true,
                    formatter: function (val) {
                        return Math.round(val) + "%";
                    }
                }
            };
            var statusChart = new ApexCharts(document.querySelector("#orderStatusChart"), statusOptions);
            statusChart.render();

            // Bar Chart: Revenue by Method
            var cashSales = @(stats.CashSales);
            var stripeSales = @(stats.StripeSales);

            var paymentOptions = {
                chart: {
                    type: 'bar',
                    height: 240,
                    toolbar: { show: false }
                },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        barHeight: '50%'
                    }
                },
                colors: ['#71dd37', '#696cff'],
                series: [{
                    name: 'Sales (BDT)',
                    data: [cashSales, stripeSales]
                }],
                xaxis: {
                    categories: ['Cash on Delivery', 'Stripe Online'],
                    labels: {
                        formatter: function (val) {
                            return '৳ ' + val.toLocaleString();
                        }
                    }
                },
                tooltip: {
                    y: {
                        formatter: function (val) {
                            return '৳ ' + val.toLocaleString('en-US', { minimumFractionDigits: 2 });
                        }
                    }
                }
            };
            var paymentChart = new ApexCharts(document.querySelector("#paymentRevenueChart"), paymentOptions);
            paymentChart.render();

            // ==============================================
            // 2. SERVER-SIDE DATATABLES
            // ==============================================
            var table = $('#orders-table').DataTable({
                processing: true,
                serverSide: true,
                order: [[2, 'desc']], // Order by Date descending
                ajax: {
                    url: '@Url.Action("GetPagedOrders", "Orders", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        d.statusFilter = $('#filter-status').val() || null;
                        d.paymentStatusFilter = $('#filter-payment-status').val() || null;
                        d.paymentMethodFilter = $('#filter-payment-method').val() || null;
                        return JSON.stringify(d);
                    }
                },
                columnDefs: [
                    { targets: 0, orderable: true },
                    { targets: 1, orderable: false },
                    { targets: 2, orderable: true },
                    { targets: 3, orderable: false },
                    { targets: 4, orderable: true },
                    { targets: 5, orderable: false },
                    { targets: 6, orderable: true },
                    {
                        targets: 7,
                        orderable: false,
                        render: function (id, type, row) {
                            return `
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" href="/Admin/Orders/Details/${id}">
                                                <i class="bx bx-show me-1 text-primary"></i> View Details
                                            </a>
                                        </li>
                                        <li>
                                            <button class="dropdown-item quick-status-btn" data-id="${id}">
                                                <i class="bx bx-sync me-1 text-info"></i> Update Status
                                            </button>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/Admin/Orders/Invoice/${id}" target="_blank">
                                                <i class="bx bx-printer me-1 text-secondary"></i> Print Invoice
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item text-warning cancel-order-btn" data-id="${id}">
                                                <i class="bx bx-x-circle me-1"></i> Cancel Order
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger delete-order-btn" data-id="${id}">
                                                <i class="bx bx-trash me-1"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            `;
                        }
                    }
                ]
            });

            // Filters Change
            $('#filter-status, #filter-payment-status, #filter-payment-method').on('change', function () {
                table.ajax.reload();
            });

            // Quick Status Update Modal
            $('#orders-table').on('click', '.quick-status-btn', function () {
                var id = $(this).data('id');
                $('#modalOrderId').val(id);
                $('#quickStatusModal').modal('show');
            });

            $('#btnSaveStatus').on('click', function () {
                var id = $('#modalOrderId').val();
                var status = $('#modalOrderStatusSelect').val();

                $.post('@Url.Action("UpdateStatus", "Orders", new { area = "Admin" })', { id: id, status: status }, function (res) {
                    $('#quickStatusModal').modal('hide');
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: res.message,
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2500
                        });
                        table.ajax.reload(null, false);
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            });

            // Cancel Order
            $('#orders-table').on('click', '.cancel-order-btn', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Cancel this order?',
                    input: 'text',
                    inputPlaceholder: 'Reason for cancellation (optional)',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ffab00',
                    confirmButtonText: 'Yes, Cancel Order'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Cancel", "Orders", new { area = "Admin" })', { id: id, reason: result.value }, function (res) {
                            if (res.success) {
                                Swal.fire('Cancelled', res.message, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        });
                    }
                });
            });

            // Delete Order
            $('#orders-table').on('click', '.delete-order-btn', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Delete Order Record?',
                    text: 'Active or delivered orders cannot be deleted. Are you sure you want to remove this record?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Delete!'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("Delete", "Orders", new { area = "Admin" })',
                            type: 'POST',
                            data: {
                                id: id,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Deleted', res.message, 'success');
                                    table.ajax.reload(null, false);
                                } else {
                                    Swal.fire('Error', res.message, 'error');
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}

