@{
    ViewData["Title"] = "Products & Catalog Intelligence";
    var stats = ViewBag.CatalogStats as MaleFashion.Application.Features.Catalogs.Products.DTOs.ProductCatalogStatsDto ?? new MaleFashion.Application.Features.Catalogs.Products.DTOs.ProductCatalogStatsDto();
    var activeCoupons = ViewBag.ActiveCoupons as List<MaleFashion.Domain.Entities.Promotions.Coupon> ?? new List<MaleFashion.Domain.Entities.Promotions.Coupon>();
}

@section Styles
{
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="~/sneat/assets/css/custom-datatables.css">

    <style>
        .kpi-card {
            cursor: pointer;
            transition: all 0.25s ease-in-out;
            border-left: 4px solid transparent !important;
        }
        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.25rem rgba(67, 89, 113, 0.15) !important;
        }
        .kpi-card.active-filter {
            box-shadow: 0 0.5rem 1.25rem rgba(105, 108, 255, 0.25) !important;
            border-color: #696cff !important;
        }
        .kpi-card.border-left-primary { border-left-color: #696cff !important; }
        .kpi-card.border-left-warning { border-left-color: #ffab00 !important; }
        .kpi-card.border-left-danger  { border-left-color: #ff3e1d !important; }
        .kpi-card.border-left-info    { border-left-color: #03c3ec !important; }

        .color-dot {
            width: 14px;
            height: 14px;
            display: inline-block;
            border-radius: 50%;
            border: 1px solid rgba(0,0,0,0.15);
            vertical-align: middle;
            margin-right: 4px;
        }
        .variant-table td {
            vertical-align: middle;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <partial name="_ResponsePartial" />
    @Html.AntiForgeryToken()

    <!-- Top KPI Catalog Cockpit Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Products Card -->
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-left-primary h-100 shadow-sm" data-filter="all">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold d-block text-muted">Total Products</span>
                        <div class="avatar avatar-sm">
                            <span class="avatar-initial rounded bg-label-primary">
                                <i class="bx bx-package fs-4"></i>
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline">
                        <h3 class="card-title mb-0 me-2">@(stats.TotalProducts.ToString("N0"))</h3>
                        <small class="text-primary fw-semibold">Catalog</small>
                    </div>
                    <small class="text-muted mt-1 d-block">
                        <i class="bx bx-layers me-1"></i>@(stats.TotalStockUnits.ToString("N0")) total stock units
                    </small>
                </div>
            </div>
        </div>

        <!-- Low Stock Warnings Card -->
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-left-warning h-100 shadow-sm" data-filter="low_stock">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold d-block text-warning">Low Stock Warnings</span>
                        <div class="avatar avatar-sm">
                            <span class="avatar-initial rounded bg-label-warning">
                                <i class="bx bx-error-circle fs-4"></i>
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline">
                        <h3 class="card-title text-warning mb-0 me-2">@(stats.LowStockAlertCount.ToString("N0"))</h3>
                        <small class="text-warning fw-semibold">Needs Attention</small>
                    </div>
                    <small class="text-muted mt-1 d-block">
                        <i class="bx bx-bell me-1"></i>Variants below alert limit
                    </small>
                </div>
            </div>
        </div>

        <!-- Out of Stock Card -->
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-left-danger h-100 shadow-sm" data-filter="out_of_stock">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold d-block text-danger">Out of Stock</span>
                        <div class="avatar avatar-sm">
                            <span class="avatar-initial rounded bg-label-danger">
                                <i class="bx bx-x-circle fs-4"></i>
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline">
                        <h3 class="card-title text-danger mb-0 me-2">@(stats.OutOfStockCount.ToString("N0"))</h3>
                        <small class="text-danger fw-semibold">Replenish</small>
                    </div>
                    <small class="text-muted mt-1 d-block">
                        <i class="bx bx-block me-1"></i>0 inventory remaining
                    </small>
                </div>
            </div>
        </div>

        <!-- Active Flash Deals Card -->
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-left-info h-100 shadow-sm" data-filter="on_sale">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold d-block text-info">Active Promotions</span>
                        <div class="avatar avatar-sm">
                            <span class="avatar-initial rounded bg-label-info">
                                <i class="bx bxs-zap fs-4"></i>
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline">
                        <h3 class="card-title text-info mb-0 me-2">@(stats.ActiveDealsCount.ToString("N0"))</h3>
                        <small class="text-info fw-semibold">Live Deals</small>
                    </div>
                    <small class="text-muted mt-1 d-block">
                        <i class="bx bx-tag-alt me-1"></i>Flash deals & sale discounts
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Store Coupons Announcement Strip (If active coupons exist) -->
    @if (activeCoupons != null && activeCoupons.Count > 0)
    {
        <div class="alert alert-primary d-flex align-items-center justify-content-between mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-primary px-3 py-2 fs-6">
                    <i class="bx bxs-discount me-1"></i>Live Store Coupons (@(activeCoupons.Count))
                </span>
                @foreach (var coupon in activeCoupons)
                {
                    var discountDisplay = coupon.DiscountType == MaleFashion.Domain.Enums.DiscountType.Percentage
                        ? $"{coupon.DiscountValue:F0}% OFF"
                        : $"৳{coupon.DiscountValue:N0} OFF";
                    var daysLeft = (int)Math.Max(1, Math.Ceiling((coupon.ExpirationDate - DateTime.UtcNow).TotalDays));

                    <div class="badge bg-white text-primary border border-primary px-3 py-2 d-inline-flex align-items-center shadow-xs">
                        <i class="bx bx-barcode-reader me-1 text-primary"></i>
                        <strong class="me-1">@coupon.Code</strong>
                        <span class="text-success fw-bold me-2">@discountDisplay</span>
                        <small class="text-muted"><i class="bx bx-time-five me-1"></i>Expires: @coupon.ExpirationDate.ToString("MMM dd, yyyy") (@daysLeft d)</small>
                    </div>
                }
            </div>
            <a asp-area="Admin" asp-controller="Coupons" asp-action="Index" class="btn btn-sm btn-outline-primary ms-2 text-nowrap">
                <i class="bx bx-slider-alt me-1"></i>Manage Coupons
            </a>
        </div>
    }

    <!-- Main Products Table Card -->
    <div class="card shadow-sm">
        <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="card-title mb-1">Catalog & Inventory Intelligence</h5>
                <p class="text-muted mb-0 small">Monitor stock health across variants, live deals, and adjust inventory.</p>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <!-- Stock Health Filters -->
                <div class="btn-group btn-group-sm" role="group" id="filterButtonGroup">
                    <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                    <button type="button" class="btn btn-outline-success" data-filter="in_stock">In Stock</button>
                    <button type="button" class="btn btn-outline-warning" data-filter="low_stock">Low Stock</button>
                    <button type="button" class="btn btn-outline-danger" data-filter="out_of_stock">Out of Stock</button>
                    <button type="button" class="btn btn-outline-info" data-filter="on_sale">Deals & Sale</button>
                </div>
                <button type="button" id="btnResetFilter" class="btn btn-sm btn-outline-secondary" title="Reset all filters">
                    <i class="bx bx-reset"></i>
                </button>
                <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="bx bx-plus me-1"></i> Add Product
                </a>
            </div>
        </div>

        <div class="card-body table-responsive pt-3">
            <partial name="_ModalPartial" />
            <table id="products" class="table table-bordered table-hover w-100">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">Image</th>
                        <th>Product & SKU</th>
                        <th>Category & Brand</th>
                        <th>Stock & Inventory</th>
                        <th>Price & Promotions</th>
                        <th style="width: 80px;">Status</th>
                        <th style="width: 90px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Variant Stock Inspection & Quick Restock Modal -->
<div class="modal fade" id="variantsStockModal" tabindex="-1" aria-labelledby="variantsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom bg-light py-3">
                <div>
                    <h5 class="modal-title mb-1" id="variantsModalLabel">
                        <i class="bx bx-layer text-primary me-2"></i>Variant Inventory Breakdown
                    </h5>
                    <div class="small text-muted" id="modalProductSubtitle">Loading product details...</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="modalLoadingSpinner" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-muted mt-2">Retrieving variant stock levels...</div>
                </div>

                <div id="modalContentWrapper" style="display: none;">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered variant-table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Variant (Size / Color)</th>
                                    <th>SKU</th>
                                    <th>Price Override</th>
                                    <th>Current Stock</th>
                                    <th>Low Alert Limit</th>
                                    <th>Health</th>
                                    <th style="width: 140px;">Quick Restock</th>
                                </tr>
                            </thead>
                            <tbody id="variantTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top bg-light py-2 d-flex justify-content-between">
                <small class="text-muted">
                    <i class="bx bx-info-circle me-1"></i>Saving an adjustment updates live customer store inventory immediately.
                </small>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <!-- DataTables Core v2 -->
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function(){
            var currentStockFilter = "all";

            // Initialize DataTables
            var table = $("#products").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                order: [[1, 'asc']],
                pagingType: "simple_numbers",
                ajax: {
                    url: "/Admin/Products/GetPagedProducts",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function(d){
                        d.StockFilter = currentStockFilter;
                        return JSON.stringify(d);
                    }
                },
                columnDefs: [
                    {
                        // Column 0: Picture
                        orderable: false,
                        targets: 0,
                        render: function(data, type, row){
                            return `
                                <img src="${data}" alt="Product" class="rounded border" style="width:48px; height:48px; object-fit: cover;" onerror="this.src='/sneat/assets/img/elements/1.jpg'" />
                            `;
                        }
                    },
                    {
                        // Column 1: Product & SKU
                        targets: 1,
                        render: function(data, type, row){
                            return data;
                        }
                    },
                    {
                        // Column 2: Category & Brand
                        targets: 2,
                        render: function(data, type, row){
                            return data;
                        }
                    },
                    {
                        // Column 3: Stock & Inventory
                        orderable: false,
                        targets: 3,
                        render: function(data, type, row){
                            return data;
                        }
                    },
                    {
                        // Column 4: Price & Promotions
                        targets: 4,
                        render: function(data, type, row){
                            return data;
                        }
                    },
                    {
                        // Column 5: Status
                        targets: 5,
                        render: function(data, type, row){
                            if(data === "Active"){
                                return '<span class="badge bg-label-success"><i class="bx bx-check me-1"></i>Active</span>';
                            } else {
                                return '<span class="badge bg-label-secondary"><i class="bx bx-minus me-1"></i>Inactive</span>';
                            }
                        }
                    },
                    {
                        // Column 6: Actions
                        orderable: false,
                        targets: 6,
                        render: function(data, type, row){
                            return `
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Actions
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <a class="dropdown-item text-primary" href="/Admin/Products/Update/${data}">
                                            <i class="bx bx-edit-alt me-2"></i> Edit Product
                                        </a>
                                    </li>
                                    <li>
                                        <button class="dropdown-item text-info view-variants-btn" data-id="${data}" data-name="Product">
                                            <i class="bx bx-layer me-2"></i> View & Restock Variants
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item text-danger show-bs-modal" data-id="${data}">
                                            <i class="bx bx-trash me-2"></i> Delete Product
                                        </button>
                                    </li>
                                </ul>
                            </div>
                            `;
                        }
                    }
                ]
            });

            // ==============================================
            // Filter Handlers (KPI Cards & Button Group)
            // ==============================================
            function applyFilter(filter) {
                currentStockFilter = filter;
                
                // Update KPI Card active styling
                $(".kpi-card").removeClass("active-filter");
                $(`.kpi-card[data-filter="${filter}"]`).addClass("active-filter");

                // Update Button Group active styling
                $("#filterButtonGroup button").removeClass("active");
                $(`#filterButtonGroup button[data-filter="${filter}"]`).addClass("active");

                table.ajax.reload();
            }

            // Click on KPI cards
            $(".kpi-card").on("click", function(){
                var filter = $(this).data("filter");
                applyFilter(filter);
            });

            // Click on Button Group filter buttons
            $("#filterButtonGroup button").on("click", function(){
                var filter = $(this).data("filter");
                applyFilter(filter);
            });

            // Reset filters
            $("#btnResetFilter").on("click", function(){
                applyFilter("all");
            });

            // ==============================================
            // Variant Inspection & Quick Restock Modal
            // ==============================================
            $(document).on("click", ".view-variants-btn", function(){
                var productId = $(this).data("id");
                var productName = $(this).data("name") || "Product";

                $("#modalProductSubtitle").html(`<strong>${productName}</strong> (ID: <code>${productId}</code>)`);
                $("#modalLoadingSpinner").show();
                $("#modalContentWrapper").hide();
                $("#variantTableBody").empty();
                $("#variantsStockModal").modal("show");

                $.ajax({
                    url: `/Admin/Products/GetVariants/${productId}`,
                    type: "GET",
                    dataType: "json",
                    success: function(response){
                        $("#modalLoadingSpinner").hide();
                        if (response.success && response.data && response.data.length > 0) {
                            var rows = "";
                            response.data.forEach(function(v){
                                var colorPreview = v.colorHex 
                                    ? `<span class="color-dot" style="background-color: ${v.colorHex};"></span>`
                                    : "";
                                var priceText = v.variantPrice != null
                                    ? `৳${parseFloat(v.variantPrice).toFixed(2)}`
                                    : `<span class="text-muted small">Standard Base</span>`;

                                var healthBadge = "";
                                if (v.healthStatus === "Healthy") {
                                    healthBadge = '<span class="badge bg-label-success"><i class="bx bx-check-circle me-1"></i>Healthy</span>';
                                } else if (v.healthStatus === "LowStock") {
                                    healthBadge = '<span class="badge bg-label-warning text-dark"><i class="bx bx-error-circle me-1"></i>Low Stock</span>';
                                } else {
                                    healthBadge = '<span class="badge bg-label-danger"><i class="bx bx-x-circle me-1"></i>Out of Stock</span>';
                                }

                                rows += `
                                    <tr data-variant-id="${v.id}">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                ${colorPreview}
                                                <div>
                                                    <span class="fw-semibold">${v.colorName || 'Standard'}</span>
                                                    <span class="badge bg-label-secondary ms-1">${v.size || 'N/A'}</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td><code>${v.sku || 'N/A'}</code></td>
                                        <td>${priceText}</td>
                                        <td class="variant-stock-display"><span class="fw-bold">${v.stockQuantity}</span> units</td>
                                        <td><span class="text-muted">${v.lowStockQuantity} units</span></td>
                                        <td class="variant-health-col">${healthBadge}</td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" min="0" class="form-control form-control-sm variant-stock-input" value="${v.stockQuantity}" />
                                                <button class="btn btn-outline-primary btn-save-variant-stock" type="button" title="Quick Save">
                                                    <i class="bx bx-check"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                `;
                            });
                            $("#variantTableBody").html(rows);
                            $("#modalContentWrapper").show();
                        } else {
                            $("#variantTableBody").html('<tr><td colspan="7" class="text-center py-4 text-muted">No variants configured for this product.</td></tr>');
                            $("#modalContentWrapper").show();
                        }
                    },
                    error: function(){
                        $("#modalLoadingSpinner").hide();
                        $("#variantTableBody").html('<tr><td colspan="7" class="text-center py-4 text-danger">Failed to load product variants.</td></tr>');
                        $("#modalContentWrapper").show();
                    }
                });
            });

            // Handle Quick Save in Modal
            $(document).on("click", ".btn-save-variant-stock", function(){
                var row = $(this).closest("tr");
                var variantId = row.data("variant-id");
                var newQty = parseInt(row.find(".variant-stock-input").val(), 10);
                var saveBtn = $(this);

                if (isNaN(newQty) || newQty < 0) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Stock Quantity",
                        text: "Please enter a valid non-negative number.",
                        timer: 2000
                    });
                    return;
                }

                saveBtn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status"></span>');

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: "/Admin/Products/QuickUpdateStock",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({
                        VariantId: variantId,
                        NewStockQuantity: newQty
                    }),
                    headers: {
                        "RequestVerificationToken": token
                    },
                    success: function(res){
                        saveBtn.prop("disabled", false).html('<i class="bx bx-check"></i>');
                        if (res.success) {
                            // Update row in modal
                            row.find(".variant-stock-display").html(`<span class="fw-bold">${newQty}</span> units`);
                            
                            // Re-evaluate health badge in row
                            var lowLimit = parseInt(row.find("td:nth-child(5)").text(), 10) || 0;
                            var newBadge = "";
                            if (newQty === 0) {
                                newBadge = '<span class="badge bg-label-danger"><i class="bx bx-x-circle me-1"></i>Out of Stock</span>';
                            } else if (newQty <= lowLimit) {
                                newBadge = '<span class="badge bg-label-warning text-dark"><i class="bx bx-error-circle me-1"></i>Low Stock</span>';
                            } else {
                                newBadge = '<span class="badge bg-label-success"><i class="bx bx-check-circle me-1"></i>Healthy</span>';
                            }
                            row.find(".variant-health-col").html(newBadge);

                            // Trigger toast
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2000,
                                timerProgressBar: true
                            });
                            Toast.fire({
                                icon: 'success',
                                title: res.message || 'Stock updated successfully!'
                            });

                            // Refresh parent table without resetting pagination
                            table.ajax.reload(null, false);
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Update Failed",
                                text: res.message || "Failed to update variant stock."
                            });
                        }
                    },
                    error: function(){
                        saveBtn.prop("disabled", false).html('<i class="bx bx-check"></i>');
                        Swal.fire({
                            icon: "error",
                            title: "Server Error",
                            text: "An error occurred while saving stock."
                        });
                    }
                });
            });

            // Allow pressing Enter on the variant stock input to trigger save
            $(document).on("keypress", ".variant-stock-input", function(e){
                if (e.which === 13) {
                    e.preventDefault();
                    $(this).siblings(".btn-save-variant-stock").trigger("click");
                }
            });

            // ==============================================
            // Delete Product Handling
            // ==============================================
            $("#products").on('click', '.show-bs-modal', function(){
                let id = $(this).data('id');
                let deleteModal = $("#delete-modal");
                deleteModal.find('#modelLabel').text("Delete Product");
                deleteModal.find('.modal-body p').html('Are you sure you want to delete this product? All variants, images, and promotions linked to it will also be permanently removed.');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/Admin/Products/Delete');
                deleteModal.modal('show');
            });

            $('#delete-btn').on('click', function(){
                $('#delete-form').submit();
            });
        });
    </script>
}
}