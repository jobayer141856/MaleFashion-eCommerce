@model List<MaleFashion.Web.Models.Account.Manage.CustomerReviewViewModel>
@{
    ViewData["Title"] = "My Reviews";
    ViewData["ActiveMenu"] = "MyReviews";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">My Reviews</h4>
                            <small class="text-muted">Product feedback and ratings submitted by your account</small>
                        </div>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Dashboard
                        </a>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="reviews-list">
                            @foreach (var review in Model)
                            {
                                <div class="review-item border rounded p-3 mb-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                                        <div>
                                            <h6 class="font-weight-bold text-dark mb-1">@review.ProductName</h6>
                                            <div class="rating-stars text-warning small">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fa fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-star-o text-muted"></i>
                                                    }
                                                }
                                                <span class="text-muted ml-2 font-weight-bold">@review.Rating / 5</span>
                                            </div>
                                        </div>
                                        <div>
                                            @if (review.IsApproved)
                                            {
                                                <span class="badge badge-success"><i class="fa fa-check-circle mr-1"></i> Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning"><i class="fa fa-clock-o mr-1"></i> Pending Approval</span>
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <p class="font-weight-bold text-dark mb-1 small">"@review.Title"</p>
                                    }
                                    <p class="text-muted small mb-2">@review.Comment</p>
                                    <small class="text-muted d-block" style="font-size: 11px;">
                                        <i class="fa fa-calendar-o mr-1"></i> Submitted on @review.CreatedAt.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-star-o fa-3x text-muted mb-3 d-block"></i>
                            <h6 class="font-weight-bold text-dark">No Reviews Yet</h6>
                            <p class="text-muted small">You haven't submitted any product reviews yet. Review your purchased items to help other shoppers!</p>
                            <a asp-action="Orders" class="btn btn-sm btn-outline-danger font-weight-bold">
                                Review Past Orders
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card, .review-item {
        border-radius: 4px;
        border: 1px solid #f0f0f0;
    }
</style>

