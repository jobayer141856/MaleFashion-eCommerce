@{
    ViewData["Title"] = "Product Reviews Moderation";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
}

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Stat Cards Overview -->
    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-message-square-detail"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0" id="stat-total">@(ViewBag.TotalReviews ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Total Reviews</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-time-five"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0 text-warning" id="stat-pending">@(ViewBag.PendingReviews ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Pending Moderation</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-circle"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0" id="stat-approved">@(ViewBag.ApprovedReviews ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Approved Reviews</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-info h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-info"><i class="bx bxs-star text-warning"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0" id="stat-avg">@(ViewBag.AverageRating != null ? string.Format("{0:0.0} / 5.0", ViewBag.AverageRating) : "0.0 / 5.0")</h4>
                    </div>
                    <p class="mb-0 text-muted">Store Average Rating</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Table Card -->
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h5 class="card-title mb-0">
                        <i class="bx bx-star text-warning me-1"></i> Product Reviews Moderation
                    </h5>
                    <!-- Filter Controls -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <select id="filter-status" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Statuses</option>
                            <option value="false" selected>Pending Moderation</option>
                            <option value="true">Approved</option>
                        </select>
                        <select id="filter-rating" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Ratings</option>
                            <option value="5">⭐⭐⭐⭐⭐ (5 Stars)</option>
                            <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
                            <option value="3">⭐⭐⭐ (3 Stars)</option>
                            <option value="2">⭐⭐ (2 Stars)</option>
                            <option value="1">⭐ (1 Star)</option>
                        </select>
                        <select id="filter-verified" class="form-select form-select-sm" style="width: auto;">
                            <option value="">All Buyers</option>
                            <option value="true">Verified Purchases Only</option>
                        </select>
                    </div>
                </div>

                <div class="card-body table-responsive pt-3">
                    <partial name="_ModalPartial" />

                    <form id="toggle-form" action="@Url.Action("ToggleApproval", "Reviews", new { area = "Admin" })" method="post" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="toggle-id" name="id" value="" />
                    </form>

                    <table id="reviews-table" class="table table-bordered table-hover w-100 align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Customer / Reviewer</th>
                                <th>Rating</th>
                                <th>Review Content</th>
                                <th>Submitted Date</th>
                                <th>Status</th>
                                <th style="width: 130px;">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Review Details Modal -->
<div class="modal fade" id="reviewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="modalReviewTitle"><i class="bx bx-comment-detail me-1"></i> Review Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Product Preview Section -->
                <div class="d-flex align-items-center p-3 mb-3 bg-light rounded">
                    <img id="modalProductImg" src="/img/product/product-1.jpg" alt="Product" class="rounded me-3" style="width:60px;height:60px;object-fit:cover;" />
                    <div>
                        <h6 id="modalProductName" class="mb-1 text-primary fw-bold">Product Name</h6>
                        <small class="text-muted" id="modalProductId">Product ID</small>
                    </div>
                </div>

                <!-- Customer Details & Rating -->
                <div class="row mb-3">
                    <div class="col-md-6 mb-2">
                        <label class="form-label text-muted small fw-semibold">Reviewer</label>
                        <div>
                            <span id="modalReviewerName" class="fw-semibold">Name</span>
                            <span id="modalVerifiedBadge" class="ms-1"></span>
                        </div>
                        <small class="text-muted" id="modalReviewerEmail">email@example.com</small>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label text-muted small fw-semibold">Rating</label>
                        <div id="modalStarRating" class="d-flex align-items-center text-warning fs-5"></div>
                    </div>
                </div>

                <!-- Review Content -->
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Review Headline</label>
                    <h6 id="modalHeadline" class="fw-bold text-dark">Great item!</h6>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Full Review Feedback</label>
                    <div id="modalComment" class="p-3 border rounded bg-light text-break" style="white-space: pre-wrap; font-size: 0.95rem;">
                        Comment text...
                    </div>
                </div>

                <!-- Metadata Footer -->
                <div class="row text-muted small">
                    <div class="col-6">
                        <span><i class="bx bx-calendar me-1"></i> Submitted: <strong id="modalCreatedAt">Date</strong></span>
                    </div>
                    <div class="col-6 text-end">
                        <span><i class="bx bx-like me-1"></i> Helpful Count: <strong id="modalHelpfulCount">0</strong></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="modalToggleBtn" class="btn btn-primary" data-id="">
                    <i class="bx bx-check me-1"></i> <span id="modalToggleText">Approve Review</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            var table = $('#reviews-table').DataTable({
                processing: true,
                serverSide: true,
                order: [[4, 'desc']], // Order by Submitted Date descending by default
                ajax: {
                    url: '@Url.Action("GetPagedReviews", "Reviews", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        var statusVal = $('#filter-status').val();
                        d.statusFilter = statusVal === "" ? null : (statusVal === "true");

                        var ratingVal = $('#filter-rating').val();
                        d.ratingFilter = ratingVal === "" ? null : parseInt(ratingVal);

                        var verifiedVal = $('#filter-verified').val();
                        d.verifiedOnly = verifiedVal === "" ? null : (verifiedVal === "true");

                        return JSON.stringify(d);
                    }
                },
                columnDefs: [
                    {
                        targets: 0,
                        orderable: true
                    },
                    {
                        targets: 1,
                        orderable: true
                    },
                    {
                        targets: 2,
                        orderable: true
                    },
                    {
                        targets: 3,
                        orderable: false
                    },
                    {
                        targets: 4,
                        orderable: true
                    },
                    {
                        targets: 5,
                        render: function (data) {
                            if (data === "Approved") {
                                return '<span class="badge bg-label-success"><i class="bx bx-check me-1"></i>Approved</span>';
                            } else {
                                return '<span class="badge bg-label-warning"><i class="bx bx-time me-1"></i>Pending</span>';
                            }
                        }
                    },
                    {
                        targets: 6,
                        orderable: false,
                        render: function (id, type, row) {
                            var isApproved = row[5] === "Approved";
                            var toggleBtnClass = isApproved ? "btn-outline-warning" : "btn-outline-success";
                            var toggleIcon = isApproved ? "bx bx-x" : "bx bx-check";
                            var toggleTitle = isApproved ? "Reject/Unapprove" : "Approve";

                            return `
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-info view-details-btn" data-id="${id}" title="View Details">
                                        <i class="bx bx-show"></i>
                                    </button>
                                    <button class="btn ${toggleBtnClass} quick-toggle-btn" data-id="${id}" title="${toggleTitle}">
                                        <i class="${toggleIcon}"></i>
                                    </button>
                                    <button class="btn btn-outline-danger delete-btn" data-id="${id}" title="Delete Review">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            // Filter Change Event Listeners
            $('#filter-status, #filter-rating, #filter-verified').on('change', function () {
                table.ajax.reload();
            });

            // Quick Toggle Approval (Inline AJAX)
            $('#reviews-table').on('click', '.quick-toggle-btn', function () {
                var btn = $(this);
                var id = btn.data('id');
                btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleApproval", "Reviews", new { area = "Admin" })',
                    type: 'POST',
                    data: { id: id },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: res.message,
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2500
                            });
                            table.ajax.reload(null, false);
                        } else {
                            Swal.fire('Error', res.message || 'Action failed.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Unable to update review approval status.', 'error');
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });

            // View Details Modal
            $('#reviews-table').on('click', '.view-details-btn', function () {
                var id = $(this).data('id');

                $.getJSON('@Url.Action("GetDetails", "Reviews", new { area = "Admin" })', { id: id }, function (res) {
                    if (res.success && res.review) {
                        var rev = res.review;
                        $('#modalProductName').text(rev.productName);
                        $('#modalProductId').text('Product ID: ' + rev.productId);
                        $('#modalProductImg').attr('src', rev.productImageUrl);
                        $('#modalReviewerName').text(rev.reviewerName);
                        $('#modalReviewerEmail').text(rev.reviewerEmail);

                        if (rev.isVerifiedPurchase) {
                            $('#modalVerifiedBadge').html('<span class="badge bg-label-success"><i class="bx bx-check-shield"></i> Verified Buyer</span>');
                        } else {
                            $('#modalVerifiedBadge').html('<span class="badge bg-label-secondary">Unverified Guest</span>');
                        }

                        // Render Stars
                        var starsHtml = '';
                        for (var i = 1; i <= 5; i++) {
                            if (i <= rev.rating) {
                                starsHtml += '<i class="bx bxs-star"></i>';
                            } else {
                                starsHtml += '<i class="bx bx-star text-secondary"></i>';
                            }
                        }
                        starsHtml += '<span class="ms-2 text-dark small fw-semibold">(' + rev.rating + ' of 5)</span>';
                        $('#modalStarRating').html(starsHtml);

                        $('#modalHeadline').text(rev.title || 'No Title');
                        $('#modalComment').text(rev.comment);
                        $('#modalCreatedAt').text(new Date(rev.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }));
                        $('#modalHelpfulCount').text(rev.helpfulCount + ' people');

                        $('#modalToggleBtn').data('id', rev.id);
                        if (rev.isApproved) {
                            $('#modalToggleBtn').removeClass('btn-success').addClass('btn-warning');
                            $('#modalToggleText').text('Unapprove Review');
                        } else {
                            $('#modalToggleBtn').removeClass('btn-warning').addClass('btn-success');
                            $('#modalToggleText').text('Approve Review');
                        }

                        $('#reviewDetailsModal').modal('show');
                    } else {
                        Swal.fire('Error', res.message || 'Could not load review details.', 'error');
                    }
                });
            });

            // Toggle from within Modal
            $('#modalToggleBtn').on('click', function () {
                var btn = $(this);
                var id = btn.data('id');
                btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleApproval", "Reviews", new { area = "Admin" })',
                    type: 'POST',
                    data: { id: id },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        $('#reviewDetailsModal').modal('hide');
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: res.message,
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2500
                            });
                            table.ajax.reload(null, false);
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Action failed.', 'error');
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });

            // Delete Review with SweetAlert2
            $('#reviews-table').on('click', '.delete-btn', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Delete Product Review?',
                    text: 'Are you sure you want to delete this customer review? This action cannot be undone and will recalculate the product rating.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#8592a3',
                    confirmButtonText: 'Yes, Delete It!'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("Delete", "Reviews", new { area = "Admin" })',
                            type: 'POST',
                            data: {
                                id: id,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Deleted!',
                                        text: res.message,
                                        timer: 2000,
                                        showConfirmButton: false
                                    });
                                    table.ajax.reload(null, false);
                                } else {
                                    Swal.fire('Error', res.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Error', 'Unable to delete review.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}

