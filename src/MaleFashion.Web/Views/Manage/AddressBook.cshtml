@model List<MaleFashion.Web.Models.Account.Manage.CustomerAddressViewModel>
@{
    ViewData["Title"] = "Address Book";
    ViewData["ActiveMenu"] = "AddressBook";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">Address Book</h4>
                            <small class="text-muted">Manage your delivery and billing addresses for quick checkout</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger font-weight-bold" data-toggle="modal" data-target="#modalAddAddress" style="background-color: #e53637; border-color: #e53637;">
                            <i class="fa fa-plus mr-1"></i> Add New Address
                        </button>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border @(item.IsDefault ? "border-danger shadow-sm" : "")">
                                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                                            <span class="badge @(item.Type == MaleFashion.Domain.Enums.AddressType.Shipping ? "badge-primary" : "badge-secondary")">
                                                @item.Type Address
                                            </span>
                                            @if (item.IsDefault)
                                            {
                                                <span class="badge badge-success"><i class="fa fa-check mr-1"></i> Default</span>
                                            }
                                        </div>
                                        <div class="card-body py-3">
                                            <p class="font-weight-bold text-dark mb-1">@item.StreetAddress</p>
                                            @if (!string.IsNullOrWhiteSpace(item.ApartmentSuite))
                                            {
                                                <p class="text-muted small mb-1">Apt/Suite: @item.ApartmentSuite</p>
                                            }
                                            <p class="text-muted small mb-0">
                                                @item.City, @item.State - @item.PostalCode<br />
                                                @item.Country
                                            </p>
                                        </div>
                                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pt-0 pb-3">
                                            <div>
                                                @if (!item.IsDefault)
                                                {
                                                    <form asp-action="SetDefaultAddress" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-link p-0 text-muted small font-weight-bold">
                                                            Set Default
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            <div>
                                                <button type="button" class="btn btn-xs btn-outline-secondary btn-edit-address mr-1"
                                                        data-id="@item.Id"
                                                        data-type="@((int)item.Type)"
                                                        data-street="@item.StreetAddress"
                                                        data-apt="@item.ApartmentSuite"
                                                        data-city="@item.City"
                                                        data-state="@item.State"
                                                        data-postal="@item.PostalCode"
                                                        data-country="@item.Country"
                                                        data-default="@(item.IsDefault ? "true" : "false")">
                                                    <i class="fa fa-pencil"></i> Edit
                                                </button>
                                                <form asp-action="DeleteAddress" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this address?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-xs btn-outline-danger">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-map-marker fa-3x text-muted mb-3 d-block"></i>
                            <h6 class="font-weight-bold text-dark">No Addresses Saved Yet</h6>
                            <p class="text-muted small mb-3">Add your home or office address to enjoy seamless checkout.</p>
                            <button type="button" class="btn btn-danger font-weight-bold" data-toggle="modal" data-target="#modalAddAddress" style="background-color: #e53637; border-color: #e53637;">
                                <i class="fa fa-plus mr-1"></i> Add Address Now
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Address -->
<div class="modal fade" id="modalAddAddress" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form asp-action="AddAddress" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Add Delivery Address</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3 clearfix">
                        <label class="font-weight-bold small d-block mb-1">Address Type</label>
                        <select name="Type" class="form-control w-100" style="width: 100% !important;" required>
                            <option value="1">Shipping Address</option>
                            <option value="2">Billing Address</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Street Address *</label>
                        <input type="text" name="StreetAddress" class="form-control" placeholder="House/Road/Street info" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Apartment, Suite, Unit (optional)</label>
                        <input type="text" name="ApartmentSuite" class="form-control" placeholder="Apt 4B, Level 3" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">City *</label>
                            <input type="text" name="City" class="form-control" placeholder="e.g. Dhaka" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">State / District *</label>
                            <input type="text" name="State" class="form-control" placeholder="e.g. Dhaka" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">Postal Code *</label>
                            <input type="text" name="PostalCode" class="form-control" placeholder="1212" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">Country *</label>
                            <input type="text" name="Country" class="form-control" value="Bangladesh" required />
                        </div>
                    </div>
                    <div class="form-check mt-2">
                        <input type="checkbox" name="IsDefault" value="true" class="form-check-input" id="chkAddDefault" />
                        <label class="form-check-label small" for="chkAddDefault">Set as default delivery address</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger font-weight-bold" style="background-color: #e53637; border-color: #e53637;">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Address -->
<div class="modal fade" id="modalEditAddress" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form asp-action="EditAddress" method="post" id="formEditAddress">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editAddressId" />
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Edit Address</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3 clearfix">
                        <label class="font-weight-bold small d-block mb-1">Address Type</label>
                        <select name="Type" id="editAddressType" class="form-control w-100" style="width: 100% !important;" required>
                            <option value="1">Shipping Address</option>
                            <option value="2">Billing Address</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Street Address *</label>
                        <input type="text" name="StreetAddress" id="editStreetAddress" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Apartment, Suite, Unit (optional)</label>
                        <input type="text" name="ApartmentSuite" id="editApartmentSuite" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">City *</label>
                            <input type="text" name="City" id="editCity" class="form-control" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">State / District *</label>
                            <input type="text" name="State" id="editState" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">Postal Code *</label>
                            <input type="text" name="PostalCode" id="editPostalCode" class="form-control" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="font-weight-bold small">Country *</label>
                            <input type="text" name="Country" id="editCountry" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check mt-2">
                        <input type="checkbox" name="IsDefault" value="true" class="form-check-input" id="editIsDefault" />
                        <label class="form-check-label small" for="editIsDefault">Set as default delivery address</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger font-weight-bold" style="background-color: #e53637; border-color: #e53637;">Update Address</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card {
        border-radius: 4px;
        border: 1px solid #f0f0f0;
    }
</style>

@section Scripts {
    <script>
        $(function () {
            $('.btn-edit-address').on('click', function () {
                var btn = $(this);
                $('#editAddressId').val(btn.data('id'));
                $('#editAddressType').val(btn.data('type'));
                $('#editStreetAddress').val(btn.data('street'));
                $('#editApartmentSuite').val(btn.data('apt'));
                $('#editCity').val(btn.data('city'));
                $('#editState').val(btn.data('state'));
                $('#editPostalCode').val(btn.data('postal'));
                $('#editCountry').val(btn.data('country'));
                $('#editIsDefault').prop('checked', btn.data('default') === true || btn.data('default') === 'true');
                $('#modalEditAddress').modal('show');
            });
        });
    </script>
}

