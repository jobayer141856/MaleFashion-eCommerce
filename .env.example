# ==============================================================================
# Environment Configuration Template for Docker Compose
# Copy this file to '.env' and adjust the values as needed.
# Note: '.env' is excluded by .gitignore and .dockerignore to keep secrets safe.
# ==============================================================================

# Application Environment
ASPNETCORE_ENVIRONMENT=Development
WEB_PORT=8080
APPLY_MIGRATIONS=true

# Database Configuration (SQL Server 2022)
DB_NAME=MaleFashion
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!
MSSQL_PID=Developer
SQL_PORT=1433

# SMTP Settings (e.g. Gmail App Password or custom SMTP server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SSLCommerz Payment Gateway Settings
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# Google reCAPTCHA v3 Settings
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_IS_ENABLED=false

