@{
    ViewData["Title"] = "Hero Slides";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">Hero Carousel Slides</h5>
                        <small class="text-muted">Manage the rotating promotional banners displayed on the home page hero section.</small>
                    </div>
                    <a asp-area="Admin" asp-controller="HeroSlides" asp-action="Create" class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i> Add Hero Slide
                    </a>
                </div>
                <div class="card-body table-responsive pt-0">
                    <partial name="_ModalPartial" />
                    <table id="slides-table" class="table table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th style="width: 90px;">Image</th>
                                <th>Subtitle / Tag</th>
                                <th>Headline Title</th>
                                <th style="width: 100px;">Order</th>
                                <th style="width: 90px;">Status</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toggle Status Hidden Form -->
<form id="toggle-form" method="post" asp-area="Admin" asp-controller="HeroSlides" asp-action="ToggleStatus">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="toggle-id" />
</form>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function() {
            $("#slides-table").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/Admin/HeroSlides/GetPagedHeroSlides",
                    type: "POST",
                    contentType: "application/json",
                    data: d => JSON.stringify(d)
                },
                columnDefs: [
                    {
                        orderable: false,
                        targets: 0,
                        render: data => `<img src="${data}" class="img-thumbnail rounded" style="width:75px; height:45px; object-fit:cover;" />`
                    },
                    {
                        orderable: false,
                        targets: -1,
                        render: data => `
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item text-warning" href="/Admin/HeroSlides/Update/${data}"><i class="bx bx-edit-alt me-1"></i> Edit</a></li>
                                    <li><button class="dropdown-item text-info btn-toggle-status" data-id="${data}"><i class="bx bx-sync me-1"></i> Toggle Status</button></li>
                                    <li><button class="dropdown-item text-danger show-bs-modal" data-id="${data}"><i class="bx bx-trash me-1"></i> Delete</button></li>
                                </ul>
                            </div>`
                    }
                ]
            });

            // Toggle Status Click Handler
            $(document).on('click', '.btn-toggle-status', function() {
                let id = $(this).data('id');
                $('#toggle-id').val(id);
                $('#toggle-form').submit();
            });

            // Delete Modal Trigger
            $("#slides-table").on('click', '.show-bs-modal', function() {
                let id = $(this).data('id');
                let deleteModal = $("#delete-modal");
                deleteModal.find('#modelLabel').text("Delete Hero Slide");
                deleteModal.find('.modal-body p').html('Are you sure you want to permanently delete this hero slide?');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/Admin/HeroSlides/Delete');
                deleteModal.modal('show');
            });

            $('#delete-btn').on('click', () => $('#delete-form').submit());
        });
    </script>
}

