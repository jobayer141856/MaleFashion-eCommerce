@model List<MaleFashion.Web.Models.Account.Manage.CustomerWishlistViewModel>
@using MaleFashion.Web.Helpers
@{
    ViewData["Title"] = "My Wishlist";
    ViewData["ActiveMenu"] = "MyWishlist";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">My Wishlist</h4>
                            <small class="text-muted">Items saved for future shopping and price monitoring</small>
                        </div>
                        <div>
                            <a asp-controller="Wishlist" asp-action="Index" class="btn btn-sm btn-outline-danger font-weight-bold mr-2">
                                <i class="fa fa-heart mr-1"></i> View Full Wishlist
                            </a>
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary font-weight-bold">
                                <i class="fa fa-arrow-left mr-1"></i> Dashboard
                            </a>
                        </div>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100 border shadow-sm">
                                        @if (!string.IsNullOrWhiteSpace(item.ProductImage))
                                        {
                                            <img src="@Url.Content(ProductImageHelper.GetProductImageUrl(item.ProductImage))" alt="@item.ProductName" style="height: 150px; width: 100%; object-fit: cover; border-top-left-radius: 4px; border-top-right-radius: 4px;">
                                        }
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    @if (item.IsInStock)
                                                    {
                                                        <span class="badge badge-success">In Stock</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-secondary">Out of Stock</span>
                                                    }
                                                    <small class="text-muted">@item.AddedAt.ToString("MMM dd")</small>
                                                </div>
                                                <h6 class="font-weight-bold text-dark mb-1 text-truncate">@item.ProductName</h6>
                                                <p class="font-weight-bold text-danger mb-3" style="color: #e53637 !important;">BDT @item.Price.ToString("N2")</p>
                                            </div>
                                            <div>
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-dark btn-block font-weight-bold py-1">
                                                    <i class="fa fa-eye mr-1"></i> View Item
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-heart-o fa-3x text-muted mb-3 d-block"></i>
                            <h6 class="font-weight-bold text-dark">Your Wishlist is Empty</h6>
                            <p class="text-muted small">Explore our clothing and fashion collections to save your favorite products!</p>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-danger font-weight-bold" style="background-color: #e53637; border-color: #e53637;">
                                Explore Products
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card {
        border-radius: 4px;
        border: 1px solid #f0f0f0;
    }
</style>

