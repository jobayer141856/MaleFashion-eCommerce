@model MaleFashion.Web.Areas.Admin.Models.CMS.HeroSlideModel

@{
    ViewData["Title"] = "Update Hero Slide";
    var existingImg = string.IsNullOrEmpty(Model.ImageUrl)
        ? "/malefashion/img/hero/hero-1.jpg"
        : (Model.ImageUrl.StartsWith("http") || Model.ImageUrl.StartsWith("/") || Model.ImageUrl.StartsWith("~")
            ? Model.ImageUrl.TrimStart('~')
            : $"/uploads/hero/{Model.ImageUrl}");
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0">Edit Hero Carousel Slide</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to List
                    </a>
                </div>
                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <!-- Subtitle / Tagline -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Subtitle"></label>
                            <input class="form-control" asp-for="Subtitle" placeholder="e.g. Summer Collection" autofocus />
                            <span asp-validation-for="Subtitle" class="text-danger"></span>
                        </div>

                        <!-- Headline Title -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Title"></label>
                            <input class="form-control" asp-for="Title" placeholder="e.g. Fall - Winter Collections 2030" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Description"></label>
                            <textarea class="form-control" asp-for="Description" rows="3" placeholder="A specialist label creating luxury essentials..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <!-- Button Text -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="ButtonText"></label>
                                <input class="form-control" asp-for="ButtonText" placeholder="e.g. Shop now" />
                                <span asp-validation-for="ButtonText" class="text-danger"></span>
                            </div>

                            <!-- Target URL -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="TargetUrl"></label>
                                <input class="form-control" asp-for="TargetUrl" placeholder="e.g. /Shop" />
                                <span asp-validation-for="TargetUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Display Order -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label" asp-for="DisplayOrder"></label>
                                <input class="form-control" asp-for="DisplayOrder" type="number" min="0" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>

                            <!-- Is Active Checkbox -->
                            <div class="col-md-6 mb-3 d-flex align-items-center pt-3">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                    <label class="form-check-label" asp-for="IsActive">Is Active (Visible on Home)</label>
                                </div>
                            </div>
                        </div>

                        <!-- Existing Photo Preview -->
                        <div class="mb-3">
                            <label class="form-label d-block">Current Hero Background</label>
                            <img src="@existingImg" alt="Current Slide" class="img-thumbnail rounded mb-2" style="max-height: 180px; width: auto;" />
                        </div>

                        <!-- Replace Photo Upload & Preview -->
                        <div class="mb-4">
                            <label class="form-label" asp-for="Photo">Replace Background Image (Optional)</label>
                            <input class="form-control" asp-for="Photo" id="photoInput" type="file" accept=".jpg,.jpeg,.png,.webp" />
                            <span asp-validation-for="Photo" class="text-danger"></span>
                            <small class="text-muted d-block mt-1">Leave blank to retain current image.</small>

                            <div class="mt-3 d-none" id="photoPreviewContainer">
                                <label class="form-label d-block text-success">New Image Preview:</label>
                                <img id="photoPreview" src="#" alt="New Preview" class="img-thumbnail rounded" style="max-height: 200px; width: auto;" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Update Hero Slide
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {
            $('#photoInput').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    $('#photoPreview').attr('src', URL.createObjectURL(file));
                    $('#photoPreviewContainer').removeClass('d-none');
                } else {
                    $('#photoPreviewContainer').addClass('d-none');
                }
            });
        });
    </script>
}

