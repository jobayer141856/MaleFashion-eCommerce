@model Disable2faModel
@{
    ViewData["Title"] = "Disable Two-Factor Authentication (2FA)";
    ViewData["ActiveMenu"] = "Security";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white" style="border-radius: 4px; border: 1px solid #f0f0f0;">

                    <!-- Title Bar -->
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-1 text-dark">Disable Two-Factor Authentication</h4>
                            <p class="text-muted small mb-0">Deactivate secondary verification during account login.</p>
                        </div>
                        <a asp-action="TwoFactorAuthentication" class="text-secondary small font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Back to 2FA
                        </a>
                    </div>

                    <!-- Warning Callout Card -->
                    <div class="alert alert-warning border-left-warning p-4 mb-4" role="alert" style="border-left: 4px solid #ffc107; background-color: #fff9e6;">
                        <h6 class="font-weight-bold text-dark mb-2">
                            <i class="fa fa-exclamation-triangle text-warning mr-1"></i> This action only disables 2FA.
                        </h6>
                        <p class="small text-muted mb-2">
                            Disabling 2FA lowers the security barrier on your storefront account. You will only need your email and password to sign in.
                        </p>
                        <p class="small text-muted mb-0">
                            <strong>Note:</strong> Disabling 2FA does <strong>not</strong> change the secret keys stored in your authenticator applications. If you want to invalidate or regenerate the app key, please <a asp-action="ResetAuthenticator" class="text-dark font-weight-bold text-decoration-underline">reset your authenticator keys</a>.
                        </p>
                    </div>

                    <!-- Action Trigger -->
                    <form asp-action="Disable2fa" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex align-items-center" style="gap: 10px;">
                            <button class="site-btn px-4 py-2" type="submit" style="background: #e53637;" onclick="return confirm('Are you sure you want to disable two-factor authentication?');">
                                <i class="fa fa-times-circle mr-1"></i> Disable 2FA
                            </button>
                            <a asp-action="TwoFactorAuthentication" class="btn btn-link text-muted font-weight-bold small">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>