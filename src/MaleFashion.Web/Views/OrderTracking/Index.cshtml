@model OrderTrackingModel
@{
    ViewData["Title"] = "Track Your Order";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Track Your Order</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Track Order</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<!-- Tracking Section Begin -->
<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="card-title text-center mb-2 font-weight-bold">Check Your Order Status</h4>
                        <p class="text-muted text-center mb-4">Enter your Order Number (e.g. <code>MF-20260921-XXXXXX</code>) and the email address used during checkout.</p>

                        <form asp-controller="OrderTracking" asp-action="Index" method="post">
                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label asp-for="OrderNumber" class="font-weight-bold text-dark">Order Number <span class="text-danger">*</span></label>
                                    <input asp-for="OrderNumber" class="form-control" placeholder="MF-YYYYMMDD-XXXXXX" />
                                    <span asp-validation-for="OrderNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label asp-for="Email" class="font-weight-bold text-dark">Email Address <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control" placeholder="yourname@example.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="text-center mt-3">
                                <button type="submit" class="site-btn px-5" style="border-radius: 4px;">Track Order</button>
                            </div>
                        </form>
                    </div>
                </div>

                @if (Model.Searched)
                {
                    if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger shadow-sm border-0" role="alert">
                            <i class="fa fa-exclamation-circle mr-2"></i> @Model.ErrorMessage
                        </div>
                    }
                    else if (Model.Order != null)
                    {
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                                <h5 class="mb-0 text-white font-weight-bold">Order #@Model.Order.OrderNumber</h5>
                                <span class="badge badge-danger px-3 py-2 text-uppercase" style="font-size: 12px; letter-spacing: 1px;">@Model.Order.Status</span>
                            </div>
                            <div class="card-body p-4">
                                <div class="row mb-4">
                                    <div class="col-md-6 mb-3 mb-md-0">
                                        <p class="mb-1 text-muted">Order Date: <strong class="text-dark">@Model.Order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</strong></p>
                                        <p class="mb-1 text-muted">Payment Method: <strong class="text-dark">@Model.Order.PaymentMethod</strong></p>
                                        <p class="mb-1 text-muted">Payment Status: <span class="badge badge-secondary">@Model.Order.PaymentStatus</span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1 text-muted">Delivery Address:</p>
                                        <p class="mb-0 font-weight-bold text-dark">@(Model.Order.ShippingAddress?.StreetAddress ?? "N/A"), @(Model.Order.ShippingAddress?.City ?? "")</p>
                                        <small class="text-muted">@(Model.Order.ShippingAddress?.State ?? "") @(Model.Order.ShippingAddress?.PostalCode ?? ""), @(Model.Order.ShippingAddress?.Country ?? "")</small>
                                    </div>
                                </div>

                                <h6 class="font-weight-bold mb-3">Order Items:</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Product</th>
                                                <th class="text-center" style="width: 80px;">Qty</th>
                                                <th class="text-right" style="width: 140px;">Unit Price</th>
                                                <th class="text-right" style="width: 140px;">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Order.OrderItems)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="font-weight-bold">@item.ProductName</span>
                                                    </td>
                                                    <td class="text-center">@item.Quantity</td>
                                                    <td class="text-right">৳@item.UnitPrice.Amount.ToString("N2")</td>
                                                    <td class="text-right font-weight-bold">৳@item.TotalPrice.Amount.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="3" class="text-right font-weight-bold">Subtotal:</td>
                                                <td class="text-right">৳@Model.Order.Subtotal.Amount.ToString("N2")</td>
                                            </tr>
                                            @if ((Model.Order.DiscountAmount?.Amount ?? 0) > 0)
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-right font-weight-bold text-success">Discount:</td>
                                                    <td class="text-right text-success">-৳@((Model.Order.DiscountAmount?.Amount ?? 0).ToString("N2"))</td>
                                                </tr>
                                            }
                                            <tr>
                                                <td colspan="3" class="text-right font-weight-bold">Shipping:</td>
                                                <td class="text-right">৳@((Model.Order.ShippingCost?.Amount ?? 0).ToString("N2"))</td>
                                            </tr>
                                            <tr class="table-active">
                                                <td colspan="3" class="text-right font-weight-bold">Grand Total:</td>
                                                <td class="text-right font-weight-bold text-danger" style="font-size: 16px;">৳@Model.Order.TotalAmount.Amount.ToString("N2")</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
<!-- Tracking Section End -->
