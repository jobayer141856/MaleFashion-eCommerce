@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate 2FA Recovery Codes";
    ViewData["ActiveMenu"] = "Security";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white" style="border-radius: 4px; border: 1px solid #f0f0f0;">

                    <!-- Title Bar -->
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-1 text-dark">Generate Recovery Codes</h4>
                            <p class="text-muted small mb-0">Reset and create a fresh batch of single-use backup keys.</p>
                        </div>
                        <a asp-action="TwoFactorAuthentication" class="text-secondary small font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Back to 2FA
                        </a>
                    </div>

                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show small mb-4" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <!-- Warning Callout Card -->
                    <div class="alert alert-warning border-left-warning p-4 mb-4" role="alert" style="border-left: 4px solid #ffc107; background-color: #fff9e6;">
                        <h6 class="font-weight-bold text-dark mb-2">
                            <i class="fa fa-exclamation-triangle text-warning mr-1"></i> Put these codes in a safe place!
                        </h6>
                        <p class="small text-muted mb-2">
                            If you lose your device and do not have these backup recovery codes, you will permanently lose access to your account.
                        </p>
                        <p class="small text-muted mb-0">
                            <strong>Note:</strong> Generating new recovery codes invalidates any previous recovery codes, but does <strong>not</strong> alter your authenticator app secret. To change the authenticator token itself, please <a asp-action="ResetAuthenticator" class="text-dark font-weight-bold text-decoration-underline">reset your authenticator keys</a>.
                        </p>
                    </div>

                    <!-- Action Trigger -->
                    <form asp-action="GenerateRecoveryCodes" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex align-items-center" style="gap: 10px;">
                            <button class="site-btn px-4 py-2" type="submit" style="background: #e53637;">
                                <i class="fa fa-refresh mr-1"></i> Generate Recovery Codes
                            </button>
                            <a asp-action="TwoFactorAuthentication" class="btn btn-link text-muted font-weight-bold small">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>