@model BlogPostModel

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Edit Blog Post</h5>
                    <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to List
                    </a>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="BlogPosts" asp-action="Update" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ExistingImageUrl" />

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label" asp-for="Title">Post Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="Title" required />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" asp-for="AuthorName">Author Name</label>
                                <input type="text" class="form-control" asp-for="AuthorName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="FeaturedImage">Replace Featured Image</label>
                                <input type="file" class="form-control" asp-for="FeaturedImage" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                {
                                    <div class="mt-2">
                                        <small class="text-muted d-block mb-1">Current Image:</small>
                                        <img src="~/uploads/blogs/@Model.ExistingImageUrl" alt="Thumbnail" class="rounded border" style="height: 70px; object-fit: cover;" />
                                    </div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="TagNamesCsv">Tags (comma-separated)</label>
                                <input type="text" class="form-control" asp-for="TagNamesCsv" />
                            </div>

                            <div class="col-12">
                                <label class="form-label" asp-for="Content">Article Content <span class="text-danger">*</span></label>
                                <textarea class="form-control" asp-for="Content" rows="12"></textarea>
                                <span asp-validation-for="Content" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="publishSwitch" />
                                    <label class="form-check-label" for="publishSwitch">Published</label>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary me-2"><i class="bx bx-save me-1"></i> Update Post</button>
                                <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}