@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-Factor Authentication (2FA)";
    ViewData["ActiveMenu"] = "Security";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white" style="border-radius: 4px; border: 1px solid #f0f0f0;">

                    <!-- Header Bar -->
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-1 text-dark">Two-Factor Authentication (2FA)</h4>
                            <p class="text-muted small mb-0">Protect your account and orders with TOTP verification.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Manage" class="text-secondary small font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Back to Profile
                        </a>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show small mb-4" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show small mb-4" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @{
                        var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
                        if (consentFeature?.CanTrack ?? true)
                        {
                            if (Model.Is2faEnabled)
                            {
                                <!-- Active 2FA Status Card -->
                                <div class="alert alert-success d-flex align-items-center mb-4 p-3" role="alert">
                                    <div class="mr-3">
                                        <i class="fa fa-shield text-success" style="font-size: 32px;"></i>
                                    </div>
                                    <div>
                                        <h6 class="font-weight-bold mb-0 text-success">Two-Factor Authentication is Active</h6>
                                        <small class="text-muted">Your account requires a code from your authenticator app during sign-in.</small>
                                    </div>
                                </div>

                                <!-- Recovery Codes Warning Alerts -->
                                if (Model.RecoveryCodesLeft == 0)
                                {
                                    <div class="alert alert-danger mb-4">
                                        <strong class="d-block mb-1"><i class="fa fa-exclamation-circle mr-1"></i> You have no recovery codes left.</strong>
                                        <small>You must <a asp-controller="Account" asp-action="GenerateRecoveryCodes" class="font-weight-bold text-danger text-decoration-underline">generate a new set of recovery codes</a> before you can log in with a recovery code.</small>
                                    </div>
                                }
                                else if (Model.RecoveryCodesLeft == 1)
                                {
                                    <div class="alert alert-danger mb-4">
                                        <strong class="d-block mb-1"><i class="fa fa-exclamation-triangle mr-1"></i> You have only 1 recovery code left.</strong>
                                        <small>You can <a asp-controller="Account" asp-action="GenerateRecoveryCodes" class="font-weight-bold text-danger text-decoration-underline">generate a new set of recovery codes</a> now to avoid account lockout.</small>
                                    </div>
                                }
                                else if (Model.RecoveryCodesLeft <= 3)
                                {
                                    <div class="alert alert-warning mb-4">
                                        <strong class="d-block mb-1"><i class="fa fa-info-circle mr-1"></i> You have @Model.RecoveryCodesLeft recovery codes left.</strong>
                                        <small>You should <a asp-controller="Account" asp-action="GenerateRecoveryCodes" class="font-weight-bold text-dark text-decoration-underline">generate a new set of recovery codes</a> soon.</small>
                                    </div>
                                }

                                <!-- Controls for Active 2FA -->
                                <div class="border rounded p-3 mb-4 bg-light">
                                    <h6 class="font-weight-bold text-dark mb-2">Manage Current Protection</h6>
                                    <div class="d-flex flex-wrap align-items-center" style="gap: 8px;">
                                        @if (Model.IsMachineRemembered)
                                        {
                                            <form asp-controller="Account" asp-action="ForgetTwoFactorClient" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="site-btn btn-sm px-3 py-2" style="background: #111111;">
                                                    <i class="fa fa-laptop mr-1"></i> Forget this browser
                                                </button>
                                            </form>
                                        }

                                        <a asp-controller="Account" asp-action="GenerateRecoveryCodes" class="site-btn btn-sm px-3 py-2" style="background: #495057;">
                                            <i class="fa fa-refresh mr-1"></i> Reset Recovery Codes
                                        </a>

                                        <a asp-controller="Account" asp-action="Disable2fa" class="site-btn btn-sm px-3 py-2" style="background: #e53637;">
                                            <i class="fa fa-times-circle mr-1"></i> Disable 2FA
                                        </a>
                                    </div>
                                </div>
                            }

                            <!-- Authenticator App Configuration -->
                            <div class="card border p-3" style="border-radius: 4px;">
                                <h6 class="font-weight-bold text-dark mb-1">Authenticator Application</h6>
                                <p class="text-muted small mb-3">Link verification tools like Google Authenticator or Microsoft Authenticator.</p>

                                <div>
                                    @if (!Model.HasAuthenticator)
                                    {
                                        <a id="enable-authenticator" asp-controller="Account" asp-action="EnableAuthenticator" class="site-btn px-4 py-2" style="background: #111111;">
                                            <i class="fa fa-plus-circle mr-1"></i> Add Authenticator App
                                        </a>
                                    }
                                    else
                                    {
                                        <a id="enable-authenticator" asp-controller="Account" asp-action="EnableAuthenticator" class="site-btn btn-sm px-3 py-2 mr-2" style="background: #111111;">
                                            <i class="fa fa-cog mr-1"></i> Set Up Authenticator App
                                        </a>
                                        <a id="reset-authenticator" asp-controller="Account" asp-action="ResetAuthenticator" class="site-btn btn-sm px-3 py-2" style="background: #6c757d;">
                                            <i class="fa fa-undo mr-1"></i> Reset Authenticator App
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger" role="alert">
                                <strong><i class="fa fa-exclamation-triangle mr-1"></i> Privacy and cookie policy have not been accepted.</strong>
                                <p class="mb-0 small mt-1">You must accept the cookie policy before you can configure two-factor authentication.</p>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}