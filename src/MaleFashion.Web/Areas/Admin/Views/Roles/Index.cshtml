@{
    ViewData["Title"] = "Role Management";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">System & Custom Roles</h5>
                        <small class="text-muted">Manage roles for Role-Based Access Control (RBAC)</small>
                    </div>
                    <a asp-area="Admin" asp-controller="Roles" asp-action="Create" class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i> Create New Role
                    </a>
                </div>
                <div class="card-body table-responsive pt-0">
                    <partial name="_ModalPartial" />
                    <table id="roles-table" class="table table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th style="width: 140px;">Assigned Users</th>
                                <th style="width: 130px;">Type</th>
                                <th style="width: 110px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function() {
            $("#roles-table").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/Admin/Roles/GetPagedRoles",
                    type: "POST",
                    contentType: "application/json",
                    data: d => JSON.stringify(d)
                },
                columnDefs: [
                    {
                        targets: 0,
                        render: data => `<strong>${data}</strong>`
                    },
                    {
                        targets: 1,
                        render: data => `<span class="badge bg-label-info">${data} User(s)</span>`
                    },
                    {
                        targets: 2,
                        render: data => data === "System"
                            ? `<span class="badge bg-label-primary"><i class="bx bx-lock-alt me-1"></i>System Role</span>`
                            : `<span class="badge bg-label-secondary">Custom Role</span>`
                    },
                    {
                        orderable: false,
                        targets: -1,
                        render: function(data, type, row) {
                            var isSystem = row[2] === "System";
                            if (isSystem) {
                                return `<span class="badge bg-label-dark" title="System roles cannot be modified">Protected</span>`;
                            }
                            return `
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item text-warning" href="/Admin/Roles/Update/${data}"><i class="bx bx-edit-alt me-1"></i> Edit</a></li>
                                        <li><button class="dropdown-item text-danger show-bs-modal" data-id="${data}" data-name="${row[0]}"><i class="bx bx-trash me-1"></i> Delete</button></li>
                                    </ul>
                                </div>`;
                        }
                    }
                ]
            });

            $("#roles-table").on('click', '.show-bs-modal', function() {
                let id = $(this).data('id');
                let name = $(this).data('name');
                let deleteModal = $("#delete-modal");
                deleteModal.find('#modelLabel').text("Delete Role");
                deleteModal.find('.modal-body p').html(`Are you sure you want to delete the role <strong>${name}</strong>?`);
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/admin/roles/delete');
                deleteModal.modal('show');
            });

            $('#delete-btn').on('click', () => $('#delete-form').submit());
        });
    </script>
}

