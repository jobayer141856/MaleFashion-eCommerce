@model MaleFashion.Web.Models.Account.Manage.ManageModel
@{
    ViewData["Title"] = "Manage My Account";
    ViewData["ActiveMenu"] = "ManageAccount";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <!-- Quick Stats Row -->
                <div class="row mb-3">
                    <div class="col-md-4 mb-2">
                        <div class="stat-card p-3 bg-white shadow-sm d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted d-block font-weight-bold">Total Orders</small>
                                <h4 class="font-weight-bold mb-0 text-dark">@Model.TotalOrders</h4>
                            </div>
                            <div class="stat-icon bg-light text-primary">
                                <i class="fa fa-shopping-bag"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="stat-card p-3 bg-white shadow-sm d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted d-block font-weight-bold">Wishlist Items</small>
                                <h4 class="font-weight-bold mb-0 text-dark">@Model.TotalWishlistItems</h4>
                            </div>
                            <div class="stat-icon bg-light text-danger">
                                <i class="fa fa-heart"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="stat-card p-3 bg-white shadow-sm d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted d-block font-weight-bold">Product Reviews</small>
                                <h4 class="font-weight-bold mb-0 text-dark">@Model.TotalReviews</h4>
                            </div>
                            <div class="stat-icon bg-light text-warning">
                                <i class="fa fa-star"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <!-- Title Bar -->
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">Account Overview</h4>
                            <small class="text-muted">Manage your profile information and track orders</small>
                        </div>
                        <a asp-action="EditProfile" class="btn btn-sm btn-outline-danger font-weight-bold">
                            <i class="fa fa-pencil mr-1"></i> Edit Profile
                        </a>
                    </div>

                    <!-- Profile & Address Cards -->
                    <div class="row mb-4">
                        <!-- Personal Profile -->
                        <div class="col-md-6 border-right">
                            <div class="pr-md-3 mb-3 mb-md-0">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold text-secondary mb-0">Personal Profile</h6>
                                    <a asp-action="EditProfile" class="small text-danger font-weight-bold">Edit</a>
                                </div>
                                <div class="profile-info-body">
                                    <p class="font-weight-bold text-dark mb-1">@Model.FirstName @Model.LastName</p>
                                    <p class="text-muted mb-1 small">
                                        <i class="fa fa-envelope-o mr-1"></i> @Model.Email
                                        @if (Model.IsEmailConfirmed)
                                        {
                                            <span class="badge badge-success ml-1" style="font-size: 10px;">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning ml-1" style="font-size: 10px;">Unverified</span>
                                        }
                                    </p>
                                    <p class="text-muted mb-1 small">
                                        <i class="fa fa-phone mr-1"></i> @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "No phone number added" : Model.PhoneNumber)
                                    </p>
                                    <p class="text-muted mb-0 small">
                                        <i class="fa fa-calendar-o mr-1"></i> Date of Birth: @(Model.DateOfBirth?.ToString("MMM dd, yyyy") ?? "Not specified")
                                        @if (!string.IsNullOrWhiteSpace(Model.Gender))
                                        {
                                            <span class="ml-2"><i class="fa fa-user mr-1"></i> Gender: @Model.Gender</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Address Book -->
                        <div class="col-md-6">
                            <div class="pl-md-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold text-secondary mb-0">Default Delivery Address</h6>
                                    <a asp-action="AddressBook" class="small text-danger font-weight-bold">Manage</a>
                                </div>
                                <div class="address-info-body">
                                    @if (Model.DefaultShippingAddress != null)
                                    {
                                        <p class="text-dark font-weight-bold mb-1">
                                            <span class="badge badge-primary mr-1" style="font-size: 10px;">@Model.DefaultShippingAddress.Type</span>
                                            @Model.DefaultShippingAddress.StreetAddress
                                        </p>
                                        <p class="text-muted mb-0 small">
                                            @if (!string.IsNullOrWhiteSpace(Model.DefaultShippingAddress.ApartmentSuite))
                                            {
                                                <span>@Model.DefaultShippingAddress.ApartmentSuite, </span>
                                            }
                                            @Model.DefaultShippingAddress.City - @Model.DefaultShippingAddress.PostalCode, @Model.DefaultShippingAddress.State, @Model.DefaultShippingAddress.Country
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-2 small">No default delivery address configured yet.</p>
                                        <a asp-action="AddressBook" class="btn btn-xs btn-outline-secondary small font-weight-bold">
                                            <i class="fa fa-plus mr-1"></i> Add Address
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Track Orders Table -->
                    <div class="track-orders-section mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="font-weight-bold mb-0 text-dark">Recent Orders</h5>
                            <a asp-action="Orders" class="small text-danger font-weight-bold">View All Orders &rarr;</a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-borderless order-table mb-0">
                                <thead>
                                    <tr class="text-secondary small font-weight-bold border-bottom">
                                        <th>Order #</th>
                                        <th>Order Date</th>
                                        <th>Items</th>
                                        <th>Status</th>
                                        <th>Total</th>
                                        <th class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                                    {
                                        @foreach (var order in Model.RecentOrders)
                                        {
                                            <tr class="border-bottom">
                                                <td><strong class="text-dark">@order.OrderNumber</strong></td>
                                                <td><small class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</small></td>
                                                <td>
                                                    <small class="text-dark">
                                                        @string.Join(", ", order.ItemNames.Take(2))
                                                        @if (order.ItemNames.Count > 2)
                                                        {
                                                            <span class="text-muted"> +@(order.ItemNames.Count - 2) more</span>
                                                        }
                                                    </small>
                                                </td>
                                                <td>
                                                    @if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Delivered)
                                                    {
                                                        <span class="badge badge-success">Delivered</span>
                                                    }
                                                    else if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Shipped)
                                                    {
                                                        <span class="badge badge-info">Shipped</span>
                                                    }
                                                    else if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Processing)
                                                    {
                                                        <span class="badge badge-primary">Processing</span>
                                                    }
                                                    else if (order.Status == MaleFashion.Domain.Enums.OrderStatus.Cancelled)
                                                    {
                                                        <span class="badge badge-danger">Cancelled</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning">Pending</span>
                                                    }
                                                </td>
                                                <td><strong class="text-dark">৳ @order.TotalAmount.ToString("N2")</strong></td>
                                                <td class="text-right">
                                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark py-1 px-2 font-weight-bold" style="font-size: 11px;">
                                                        Details
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted small">
                                                <i class="fa fa-shopping-bag fa-2x text-muted mb-2 d-block"></i>
                                                No recent orders found. Discover our latest collections on the storefront!
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card, .stat-card {
        border-radius: 4px;
        border: 1px solid #f0f0f0;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .order-table td, .order-table th {
        vertical-align: middle;
        padding: 14px 10px;
    }

    .order-table thead th {
        border-bottom: 2px solid #ededed;
    }
</style>
</style>