@{
    ViewData["Title"] = "Flash Deals";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css">
}

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Stat Cards Overview -->
    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-timer"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.TotalDeals ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Total Campaigns</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-success"><i class="bx bx-broadcast"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.LiveDeals ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Live / Running</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-info h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-info"><i class="bx bx-calendar-event"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.UpcomingDeals ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Upcoming Deals</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card card-border-shadow-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-history"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@(ViewBag.ExpiredDeals ?? 0)</h4>
                    </div>
                    <p class="mb-0 text-muted">Expired Deals</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Deals Table Card -->
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <div class="card">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Flash Deals & Countdowns</h5>
                    <a asp-area="Admin" asp-controller="DealCountdowns" asp-action="Create" class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i> Add Flash Deal
                    </a>
                </div>
                <div class="card-body table-responsive pt-0">
                    <partial name="_ModalPartial" />
                    <table id="deals-table" class="table table-bordered table-hover w-100">
                        <thead>
                            <tr>
                                <th>Featured Product</th>
                                <th>Deal Title</th>
                                <th>Special Pricing</th>
                                <th>End Date</th>
                                <th style="width: 100px;">Status</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Toggle Form -->
<form id="toggle-form" action="/Admin/DealCountdowns/ToggleStatus" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="toggle-id" name="id" />
</form>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function() {
            var table = $("#deals-table").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                order: [[3, 'desc']],
                ajax: {
                    url: "/Admin/DealCountdowns/GetPagedDealCountdowns",
                    type: "POST",
                    contentType: "application/json",
                    data: d => JSON.stringify(d)
                },
                columnDefs: [
                    {
                        targets: 4,
                        render: function(data) {
                            if (data === "Live")
                                return '<span class="badge bg-label-success"><i class="bx bx-broadcast me-1"></i>Live</span>';
                            else if (data === "Upcoming")
                                return '<span class="badge bg-label-info"><i class="bx bx-calendar me-1"></i>Upcoming</span>';
                            else if (data === "Expired")
                                return '<span class="badge bg-label-warning">Expired</span>';
                            else
                                return '<span class="badge bg-label-secondary">Inactive</span>';
                        }
                    },
                    {
                        orderable: false,
                        targets: -1,
                        render: function(data, type, row) {
                            var status = row[4];
                            var toggleText = status === "Inactive" ? "Activate" : "Deactivate";
                            var toggleIcon = status === "Inactive" ? "bx-check-circle text-success" : "bx-block text-warning";

                            return `
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item text-warning" href="/Admin/DealCountdowns/Update/${data}">
                                                <i class="bx bx-edit-alt me-1"></i> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <button class="dropdown-item toggle-btn" data-id="${data}">
                                                <i class="bx ${toggleIcon} me-1"></i> ${toggleText}
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger show-bs-modal" data-id="${data}">
                                                <i class="bx bx-trash me-1"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>`;
                        }
                    }
                ]
            });

            // Toggle Status Handler
            $("#deals-table").on('click', '.toggle-btn', function() {
                var id = $(this).data('id');
                $('#toggle-id').val(id);
                $('#toggle-form').submit();
            });

            // Delete Modal Handler
            $("#deals-table").on('click', '.show-bs-modal', function() {
                var id = $(this).data('id');
                var deleteModal = $("#delete-modal");
                deleteModal.find('#modelLabel').text("Delete Flash Deal");
                deleteModal.find('.modal-body p').html('Are you sure you want to delete this flash deal campaign?');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/Admin/DealCountdowns/Delete');
                deleteModal.modal('show');
            });

            $('#delete-btn').on('click', function() {
                $('#delete-form').submit();
            });
        });
    </script>
}

