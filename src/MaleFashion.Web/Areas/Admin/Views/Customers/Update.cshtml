@model MaleFashion.Web.Areas.Admin.Models.Customers.CustomerModel

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <form asp-area="Admin" asp-controller="Customers" asp-action="Update" asp-antiforgery="true" method="post">
                <input type="hidden" asp-for="Id" />

                <!-- Personal Information Card -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Edit Customer: @Model.FirstName @Model.LastName</h5>
                        <div>
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-info me-1">
                                <i class="bx bx-show me-1"></i> View Profile
                            </a>
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                <i class="bx bx-arrow-back me-1"></i> Back to List
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" asp-for="FirstName">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="FirstName" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" asp-for="LastName">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="LastName" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="Email">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" asp-for="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" asp-for="PhoneNumber">Phone Number <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" asp-for="PhoneNumber" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="Gender">Gender</label>
                                <select class="form-select" asp-for="Gender">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" asp-for="DateOfBirth">Date of Birth</label>
                                <input type="date" class="form-control" asp-for="DateOfBirth" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer Addresses Management Card -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Customer Addresses</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addAddressBtn">
                            <i class="bx bx-plus me-1"></i> Add Address
                        </button>
                    </div>
                    <div class="card-body" id="addressesContainer">
                        @if (Model.Addresses != null && Model.Addresses.Count > 0)
                        {
                            for (int i = 0; i < Model.Addresses.Count; i++)
                            {
                                <div class="border rounded p-3 mb-3 address-block position-relative bg-light">
                                    <input type="hidden" name="Addresses[@i].Id" value="@Model.Addresses[i].Id" />
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                        <h6 class="mb-0 text-primary">Address #@(i + 1)</h6>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-address-btn">
                                            <i class="bx bx-trash me-1"></i> Remove
                                        </button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label">Address Type</label>
                                            <select name="Addresses[@i].Type" class="form-select">
                                                <option value="Shipping" selected="@(Model.Addresses[i].Type == MaleFashion.Domain.Enums.AddressType.Shipping)">Shipping</option>
                                                <option value="Billing" selected="@(Model.Addresses[i].Type == MaleFashion.Domain.Enums.AddressType.Billing)">Billing</option>
                                            </select>
                                        </div>
                                        <div class="col-md-7">
                                            <label class="form-label">Street Address <span class="text-danger">*</span></label>
                                            <input type="text" name="Addresses[@i].StreetAddress" class="form-control" value="@Model.Addresses[i].StreetAddress" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Apt / Suite</label>
                                            <input type="text" name="Addresses[@i].ApartmentSuite" class="form-control" value="@Model.Addresses[i].ApartmentSuite" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">City <span class="text-danger">*</span></label>
                                            <input type="text" name="Addresses[@i].City" class="form-control" value="@Model.Addresses[i].City" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">State <span class="text-danger">*</span></label>
                                            <input type="text" name="Addresses[@i].State" class="form-control" value="@Model.Addresses[i].State" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Postal Code <span class="text-danger">*</span></label>
                                            <input type="text" name="Addresses[@i].PostalCode" class="form-control" value="@Model.Addresses[i].PostalCode" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Country</label>
                                            <input type="text" name="Addresses[@i].Country" class="form-control" value="@Model.Addresses[i].Country" required />
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Addresses[@i].IsDefault" value="true" id="def_@i" checked="@Model.Addresses[i].IsDefault" />
                                                <label class="form-check-label" for="def_@i">Set as Default Address</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0" id="noAddressesMsg">No addresses added yet. Click "Add Address" above to add one.</p>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <button type="submit" class="btn btn-primary me-2"><i class="bx bx-save me-1"></i> Update Customer</button>
                    <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {
            let addressIndex = @(Model.Addresses?.Count ?? 0);

            $('#addAddressBtn').on('click', function() {
                $('#noAddressesMsg').hide();

                let newAddressHtml = `
                            <div class="border rounded p-3 mb-3 address-block position-relative bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <h6 class="mb-0 text-primary">New Address</h6>
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-address-btn">
                                        <i class="bx bx-trash me-1"></i> Remove
                                    </button>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Address Type</label>
                                        <select name="Addresses[${addressIndex}].Type" class="form-select">
                                            <option value="Shipping" selected>Shipping</option>
                                            <option value="Billing">Billing</option>
                                        </select>
                                    </div>
                                    <div class="col-md-7">
                                        <label class="form-label">Street Address <span class="text-danger">*</span></label>
                                        <input type="text" name="Addresses[${addressIndex}].StreetAddress" class="form-control" placeholder="House 12, Road 4, Sector 7" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Apt / Suite</label>
                                        <input type="text" name="Addresses[${addressIndex}].ApartmentSuite" class="form-control" placeholder="Flat 4B" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">City <span class="text-danger">*</span></label>
                                        <input type="text" name="Addresses[${addressIndex}].City" class="form-control" placeholder="Dhaka" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">State <span class="text-danger">*</span></label>
                                        <input type="text" name="Addresses[${addressIndex}].State" class="form-control" placeholder="Dhaka" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Postal Code <span class="text-danger">*</span></label>
                                        <input type="text" name="Addresses[${addressIndex}].PostalCode" class="form-control" placeholder="1230" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Country</label>
                                        <input type="text" name="Addresses[${addressIndex}].Country" class="form-control" value="Bangladesh" required />
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="Addresses[${addressIndex}].IsDefault" value="true" id="def_${addressIndex}" />
                                            <label class="form-check-label" for="def_${addressIndex}">Set as Default Address</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;

                $('#addressesContainer').append(newAddressHtml);
                addressIndex++;
            });

            $('#addressesContainer').on('click', '.remove-address-btn', function() {
                $(this).closest('.address-block').remove();
                if ($('.address-block').length === 0) {
                    $('#noAddressesMsg').show();
                }
            });
        });
    </script>
}