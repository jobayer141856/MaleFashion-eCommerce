@model MaleFashion.Web.Areas.Admin.Models.Security.RoleModel

@{
    ViewData["Title"] = "Create Predefined Role";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-7 col-lg-9 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom py-3">
                    <div>
                        <h5 class="card-title mb-0">
                            <i class="bx bx-shield-plus text-primary me-2"></i>Create New Role
                        </h5>
                        <small class="text-muted">Select an uncreated operational role from the predefined system roles</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to List
                    </a>
                </div>
                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    @if (Model.AvailableRoles != null && Model.AvailableRoles.Any())
                    {
                        <form asp-action="Create" method="post" id="formCreateRole">
                            @Html.AntiForgeryToken()

                            <!-- Role Selection Dropdown -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold" asp-for="Name">Choose Role to Create</label>
                                <select class="form-select" asp-for="Name" id="roleSelect" autofocus>
                                    <option value="" disabled selected>-- Select an uncreated role --</option>
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <option value="@role.Value" data-desc="@role.Description">
                                            @role.DisplayName (@role.Value)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                                <div class="form-text">Roles that already exist in the database are automatically excluded from this list.</div>
                            </div>

                            <!-- Dynamic Role Description Card -->
                            <div id="roleDescriptionCard" class="alert alert-primary d-none py-3 px-3 mb-4" role="alert">
                                <div class="d-flex align-items-start">
                                    <i class="bx bx-info-circle fs-4 me-2 flex-shrink-0 mt-1"></i>
                                    <div>
                                        <h6 class="alert-heading fw-bold mb-1" id="roleTitle">Role Permissions</h6>
                                        <p class="mb-0 small text-body" id="roleDescText"></p>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-primary" id="btnSubmit">
                                    <i class="bx bx-save me-1"></i> Create Role
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <!-- All Roles Already Created Notice -->
                        <div class="text-center py-4">
                            <span class="badge bg-label-success p-3 rounded-circle mb-3">
                                <i class="bx bx-check-double fs-1 text-success"></i>
                            </span>
                            <h5 class="mb-2">All Predefined Roles Configured</h5>
                            <p class="text-muted mb-4" style="max-width: 480px; margin: 0 auto;">
                                Every system and operational role defined in the application has already been created in the database.
                            </p>
                            <a asp-action="Index" class="btn btn-primary">
                                <i class="bx bx-shield-quarter me-1"></i> View Role Directory
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectEl = document.getElementById('roleSelect');
            const cardEl = document.getElementById('roleDescriptionCard');
            const titleEl = document.getElementById('roleTitle');
            const descEl = document.getElementById('roleDescText');

            if (selectEl && cardEl) {
                selectEl.addEventListener('change', function () {
                    const selectedOption = selectEl.options[selectEl.selectedIndex];
                    const desc = selectedOption.getAttribute('data-desc');
                    const text = selectedOption.text;

                    if (desc) {
                        titleEl.textContent = text + ' Permissions:';
                        descEl.textContent = desc;
                        cardEl.classList.remove('d-none');
                    } else {
                        cardEl.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}

