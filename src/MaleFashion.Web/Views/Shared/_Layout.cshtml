@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="zxx">
<head>
    <meta charset="UTF-8" />
    <meta name="description" content="Male_Fashion" />
    <meta name="keywords" content="Male_Fashion, unica, creative, html" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>@ViewData["Title"] - Male-Fashion</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Css Styles -->
    <link rel="stylesheet" href="~/malefashion/css/bootstrap.min.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/font-awesome.min.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/elegant-icons.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/magnific-popup.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/nice-select.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/owl.carousel.min.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/slicknav.min.css" type="text/css" />
    <link rel="stylesheet" href="~/malefashion/css/style.css" type="text/css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Page Preloder -->
    <div id="preloder">
        <div class="loader"></div>
    </div>

    <!-- Offcanvas Menu Begin -->
    <div class="offcanvas-menu-overlay"></div>
    <div class="offcanvas-menu-wrapper">
        <div class="offcanvas__option">
            <div class="offcanvas__links">
                <partial name="_LoginPartial" />
                <a href="#">FAQs</a>
            </div>
            <div class="offcanvas__top__hover">
                <span>BDT <i class="arrow_carrot-down"></i></span>
                <ul>
                    <li>BDT</li>
                    <li>USD</li>
                    <li>EUR</li>
                </ul>
            </div>
        </div>
        <div class="offcanvas__nav__option">
            <a href="#" class="search-switch"><img src="~/malefashion/img/icon/search.png" alt="" /></a>
            <a href="#"><img src="~/malefashion/img/icon/heart.png" alt="" /></a>
            @await Component.InvokeAsync("CartSummary")
        </div>
        <div id="mobile-menu-wrap"></div>
        <div class="offcanvas__text">
            <p>Free shipping, 30-day return or refund guarantee.</p>
        </div>
    </div>
    <!-- Offcanvas Menu End -->
    <!-- Header Section Begin -->
    <header class="header">
        <div class="header__top">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-md-7">
                        <div class="header__top__left">
                            <p>Free shipping, 30-day return or refund guarantee.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-5">
                        <div class="header__top__right">
                            <div class="header__top__links">
                                <partial name="_LoginPartial" />
                                <a href="#">FAQs</a>
                            </div>
                            <div class="header__top__hover">
                                <span>BDT <i class="arrow_carrot-down"></i></span>
                                <ul>
                                    <li>BDT</li>
                                    <li>USD</li>
                                    <li>EUR</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-3">
                    <div class="header__logo">
                        <a asp-controller="Home" asp-action="Index"><img src="~/malefashion/img/logo.png" alt="" /></a>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <nav class="header__menu mobile-menu">
                        <ul>
                            <li class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                                <a asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="@(currentController == "Shop" ? "active" : "")">
                                <a asp-controller="Shop" asp-action="Index">Shop</a>
                            </li>
                            <li class="@(currentController == "About" || currentController == "Pages" ? "active" : "")">
                                <a href="#">Pages</a>
                                <ul class="dropdown">
                                    <li><a asp-controller="About" asp-action="Index">About Us</a></li>
                                    <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                                    <li><a asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                                    <li><a asp-controller="BlogPosts" asp-action="Index">Blog</a></li>
                                </ul>
                            </li>
                            <li class="@(currentController == "BlogPosts" ? "active" : "")">
                                <a asp-controller="BlogPosts" asp-action="Index">Blog</a>
                            </li>
                            <li class="@(currentController == "ContactInquiry" || currentController == "Contact" || currentController == "Contacts" ? "active" : "")">
                                <a asp-controller="ContactInquiry" asp-action="Index">Contacts</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <div class="col-lg-3 col-md-3">
                    <div class="header__nav__option">
                        <a href="#" class="search-switch"><img src="~/malefashion/img/icon/search.png" alt="" /></a>
                        <a href="#"><img src="~/malefashion/img/icon/heart.png" alt="" /></a>
                        @await Component.InvokeAsync("CartSummary")
                    </div>
                </div>
            </div>
            <div class="canvas__open"><i class="fa fa-bars"></i></div>
        </div>
    </header>
    <!-- Header Section End -->
    <!-- Main Dynamic Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer Section Begin -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="footer__about">
                        <div class="footer__logo">
                            <a href="#"><img src="~/malefashion/img/footer-logo.png" alt="" /></a>
                        </div>
                        <p>The customer is at the heart of our unique business model, which includes design.</p>
                        <a href="#"><img src="~/malefashion/img/payment.png" alt="" /></a>
                    </div>
                </div>
                <div class="col-lg-2 offset-lg-1 col-md-3 col-sm-6">
                    <div class="footer__widget">
                        <h6>Shopping</h6>
                        <ul>
                            <li><a href="#">Clothing Store</a></li>
                            <li><a href="#">Trending Shoes</a></li>
                            <li><a href="#">Accessories</a></li>
                            <li><a href="#">Sale</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <div class="footer__widget">
                        <h6>Shopping</h6>
                        <ul>
                            <li><a asp-controller="ContactInquiry" asp-action="Index">Contact Us</a></li>
                            <li><a href="#">Payment Methods</a></li>
                            <li><a href="#">Delivary</a></li>
                            <li><a href="#">Return & Exchanges</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3 offset-lg-1 col-md-6 col-sm-6">
                    <div class="footer__widget">
                        <h6>NewLetter</h6>
                        <div class="footer__newslatter">
                            <p>Be the first to know about new arrivals, look books, sales & promos!</p>
                            <form id="footer-newsletter-form" asp-controller="Newsletter" asp-action="Subscribe" method="post">
                                @Html.AntiForgeryToken()
                                <input type="email" id="footer-newsletter-email" name="Email" placeholder="Your email" required />
                                <button type="submit" id="footer-newsletter-btn"><span class="icon_mail_alt"></span></button>
                            </form>
                            <div id="footer-newsletter-feedback" class="mt-2" style="font-size: 13px; display: none;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="footer__copyright__text">
                        <p>
                            Copyright © @DateTime.Now.Year All rights reserved | This template is made with
                            <i class="fa fa-heart-o" aria-hidden="true"></i> by
                            <a href="https://colorlib.com" target="_blank">Colorlib</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- Footer Section End -->
    <!-- Search Begin -->
    <div class="search-model">
        <div class="h-100 d-flex align-items-center justify-content-center">
            <div class="search-close-switch">+</div>
            <form class="search-model-form">
                <input type="text" id="search-input" placeholder="Search here....." />
            </form>
        </div>
    </div>
    <!-- Search End -->
    <!-- Js Plugins -->
    <script src="~/malefashion/js/jquery-3.3.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/malefashion/js/jquery.nice-select.min.js"></script>
    <script src="~/malefashion/js/jquery.nicescroll.min.js"></script>
    <script src="~/malefashion/js/jquery.magnific-popup.min.js"></script>
    <script src="~/malefashion/js/jquery.countdown.min.js"></script>
    <script src="~/malefashion/js/jquery.slicknav.js"></script>
    <script src="~/malefashion/js/mixitup.min.js"></script>
    <script src="~/malefashion/js/owl.carousel.min.js"></script>
    <script src="~/malefashion/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function() {
            $('#footer-newsletter-form').on('submit', function(e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $('#footer-newsletter-btn');
                var $emailInput = $('#footer-newsletter-email');
                var $feedback = $('#footer-newsletter-feedback');
                var email = $emailInput.val().trim();

                if (!email) {
                    $feedback.html('<span class="text-danger">Please enter your email.</span>').fadeIn();
                    return;
                }

                $btn.prop('disabled', true).find('span').removeClass('icon_mail_alt').addClass('fa fa-spinner fa-spin');
                $feedback.hide();

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(res) {
                        $btn.prop('disabled', false).find('span').removeClass('fa fa-spinner fa-spin').addClass('icon_mail_alt');
                        if (res && res.success) {
                            $emailInput.val('');
                            $feedback.html('<span class="text-success">' + res.message + '</span>').fadeIn();
                            Swal.fire({
                                icon: 'success',
                                title: 'Subscribed!',
                                text: res.message,
                                timer: 3000,
                                showConfirmButton: false
                            });
                        } else {
                            var msg = (res && res.message) ? res.message : 'Subscription failed. Please try again.';
                            $feedback.html('<span class="text-warning">' + msg + '</span>').fadeIn();
                            Swal.fire({
                                icon: 'warning',
                                title: 'Notice',
                                text: msg
                            });
                        }
                    },
                    error: function() {
                        $btn.prop('disabled', false).find('span').removeClass('fa fa-spinner fa-spin').addClass('icon_mail_alt');
                        var errMsg = 'Unable to subscribe at the moment. Please try again.';
                        $feedback.html('<span class="text-danger">' + errMsg + '</span>').fadeIn();
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: errMsg
                        });
                    }
                });
            });

            @if (TempData["CartSuccess"] != null || TempData["Success"] != null || TempData["SuccessMessage"] != null)
            {
                var successMsg = (TempData["CartSuccess"] ?? TempData["Success"] ?? TempData["SuccessMessage"])?.ToString();
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '@Html.Raw(successMsg)',
                    timer: 3000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
                </text>
            }
            @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
            {
                var errorMsg = (TempData["Error"] ?? TempData["ErrorMessage"])?.ToString();
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '@Html.Raw(errorMsg)'
                });
                </text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>