@model MaleFashion.Web.Areas.Admin.Models.Catalogs.ProductModel

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <partial name="_ResponsePartial" />
            <form asp-area="Admin" asp-controller="Products" asp-action="Update" asp-antiforgery="true" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <!-- General Info Card -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Edit Product: @Model.Name</h5>
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            <i class="bx bx-arrow-back me-1"></i> Back to List
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label" asp-for="Name">Product Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="Name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" asp-for="Sku">SKU <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="Sku" />
                                <span asp-validation-for="Sku" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="CategoryId">Category <span class="text-danger">*</span></label>
                                <select class="form-select" id="CategoryId" name="CategoryId" required>
                                    @if (Model.CategoryId != Guid.Empty && !string.IsNullOrEmpty(Model.CategoryName))
                                    {
                                        <option value="@Model.CategoryId" selected="selected">@Model.CategoryName</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="BrandId">Brand <span class="text-danger">*</span></label>
                                <select class="form-select" id="BrandId" name="BrandId" required>
                                    @if (Model.BrandId != Guid.Empty && !string.IsNullOrEmpty(Model.BrandName))
                                    {
                                        <option value="@Model.BrandId" selected="selected">@Model.BrandName</option>
                                    }
                                </select>
                                <span asp-validation-for="BrandId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="BasePrice">Base Price (৳) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" asp-for="BasePrice" />
                                <span asp-validation-for="BasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="SalePrice">Sale Price (৳) (Optional)</label>
                                <input type="number" step="0.01" class="form-control" asp-for="SalePrice" />
                                <span asp-validation-for="SalePrice" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label" asp-for="Description">Description <span class="text-danger">*</span></label>
                                <textarea rows="4" class="form-control" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label" asp-for="AdditionalInformation">Additional Information</label>
                                <textarea rows="2" class="form-control" asp-for="AdditionalInformation"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Media Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Product Images</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PrimaryImage" class="form-label">Replace Primary Image</label>
                                @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
                                {
                                    <div class="mb-2">
                                        <label class="form-label d-block text-muted">Current Primary Image:</label>
                                        <img src="/uploads/products/@Model.PrimaryImageUrl" alt="Current Primary" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                                    </div>
                                }
                                <input asp-for="PrimaryImage" class="form-control" type="file" id="primaryImageInput" accept=".jpg,.jpeg,.png,.webp" />
                                <small class="text-muted">Allowed: JPG, JPEG, PNG, WEBP.</small>

                                <div class="mt-3" id="primaryImagePreviewWrapper" style="display: none;">
                                    <label class="form-label d-block">New Preview:</label>
                                    <img id="primaryImagePreview" src="#" alt="New Preview" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="GalleryImages" class="form-label">Add More Gallery Images</label>
                                <input asp-for="GalleryImages" class="form-control" type="file" multiple accept=".jpg,.jpeg,.png,.webp" />
                                <small class="text-muted">Upload additional gallery photos.</small>

                                @if (Model.ExistingGalleryImages != null && Model.ExistingGalleryImages.Count > 0)
                                {
                                    <div class="mt-3">
                                        <label class="form-label d-block">Current Gallery Images (Check to Remove):</label>
                                        <div class="d-flex flex-wrap gap-3">
                                            @foreach (var img in Model.ExistingGalleryImages)
                                            {
                                                <div class="card p-1 text-center" style="width: 100px;">
                                                    <img src="/uploads/products/@img.ImageUrl" class="img-fluid rounded mb-1" style="height: 70px; object-fit: cover;" />
                                                    <div class="form-check d-flex justify-content-center">
                                                        <input class="form-check-input" type="checkbox" name="deletedImageIds" value="@img.Id" id="del_@img.Id" />
                                                        <label class="form-check-label ms-1 text-danger small" for="del_@img.Id">Del</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Variants Card -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Product Variants & Stock</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addVariantBtn">
                            <i class="bx bx-plus me-1"></i> Add Variant
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="variantsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Size</th>
                                        <th>Color Name</th>
                                        <th style="width: 90px;">Color</th>
                                        <th>Stock Qty</th>
                                        <th>Low Stock Alert</th>
                                        <th style="width: 50px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="variantsBody">
                                    @for (int i = 0; i < Model.Variants.Count; i++)
                                    {
                                        <tr class="variant-row">
                                            <td>
                                                <input type="hidden" name="Variants[@i].Id" value="@Model.Variants[i].Id" />
                                                <input type="text" name="Variants[@i].Size" class="form-control" value="@Model.Variants[i].Size" required />
                                            </td>
                                            <td>
                                                <input type="text" name="Variants[@i].ColorName" class="form-control" value="@Model.Variants[i].ColorName" />
                                            </td>
                                            <td>
                                                <input type="color" name="Variants[@i].ColorHex" class="form-control form-control-color" value="@Model.Variants[i].ColorHex" />
                                            </td>
                                            <td>
                                                <input type="number" name="Variants[@i].StockQuantity" class="form-control" value="@Model.Variants[i].StockQuantity" min="0" required />
                                            </td>
                                            <td>
                                                <input type="number" name="Variants[@i].LowStockQuantity" class="form-control" value="@Model.Variants[i].LowStockQuantity" min="0" />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-variant-btn"><i class="bx bx-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Visibility & Status Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Visibility & Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                    <label class="form-check-label" asp-for="IsActive">Active on Storefront</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsNewArrival" />
                                    <label class="form-check-label" asp-for="IsNewArrival">Mark as New Arrival</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsHotSale" />
                                    <label class="form-check-label" asp-for="IsHotSale">Mark as Hot Sale</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <button type="submit" class="btn btn-primary me-2"><i class="bx bx-save me-1"></i> Update Product</button>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            // Category Select2
            $('#CategoryId').select2({
                theme: 'bootstrap-5',
                placeholder: 'Search category...',
                allowClear: true,
                ajax: {
                    url: '/Admin/Categories/GetAllCategories',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return { id: item.id, text: item.name };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Brand Select2
            $('#BrandId').select2({
                theme: 'bootstrap-5',
                placeholder: 'Search brand...',
                allowClear: true,
                ajax: {
                    url: '/Admin/Brands/GetAllBrands',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return { id: item.id, text: item.name };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Primary Image Live Preview using createObjectURL
            $('#primaryImageInput').on('change', function () {
                var file = this.files && this.files[0];
                if (file) {
                    var objectUrl = URL.createObjectURL(file);
                    $('#primaryImagePreview').attr('src', objectUrl);
                    $('#primaryImagePreviewWrapper').show();
                } else {
                    $('#primaryImagePreviewWrapper').hide();
                }
            });

            // Dynamic Variants
            let variantIndex = @(Model.Variants?.Count ?? 0);
            $('#addVariantBtn').on('click', function () {
                let newRow = `
                    <tr class="variant-row">
                        <td>
                            <input type="text" name="Variants[${variantIndex}].Size" class="form-control" placeholder="Size" required />
                        </td>
                        <td>
                            <input type="text" name="Variants[${variantIndex}].ColorName" class="form-control" placeholder="Color" />
                        </td>
                        <td>
                            <input type="color" name="Variants[${variantIndex}].ColorHex" class="form-control form-control-color" value="#000000" />
                        </td>
                        <td>
                            <input type="number" name="Variants[${variantIndex}].StockQuantity" class="form-control" value="0" min="0" required />
                        </td>
                        <td>
                            <input type="number" name="Variants[${variantIndex}].LowStockQuantity" class="form-control" value="0" min="0" />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-variant-btn"><i class="bx bx-trash"></i></button>
                        </td>
                    </tr>
                `;
                $('#variantsBody').append(newRow);
                variantIndex++;
            });

            $('#variantsBody').on('click', '.remove-variant-btn', function () {
                if ($('#variantsBody tr').length > 1) {
                    $(this).closest('tr').remove();
                } else {
                    alert('At least one product variant is required.');
                }
            });
        });
    </script>
}
</div>