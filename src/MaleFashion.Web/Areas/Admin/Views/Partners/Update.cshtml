@model MaleFashion.Web.Areas.Admin.Models.CMS.PartnerClientModel

@{
    ViewData["Title"] = "Edit Partner Client";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0">Edit Partner Client</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to List
                    </a>
                </div>
                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="LogoUrl" />

                        <!-- Client Name -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="ClientName"></label>
                            <input class="form-control" asp-for="ClientName" />
                            <span asp-validation-for="ClientName" class="text-danger"></span>
                        </div>

                        <!-- Current Logo & Replacement -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Logo"></label>

                            @if (!string.IsNullOrEmpty(Model.LogoUrl))
                            {
                                var currentLogo = Model.LogoUrl.StartsWith("malefashion") || Model.LogoUrl.StartsWith("/")
                                    ? "/" + Model.LogoUrl.TrimStart('/')
                                    : "/uploads/partners/" + Model.LogoUrl;
                                <div class="mb-2" id="currentLogoContainer">
                                    <p class="text-muted small mb-1">Current Logo:</p>
                                    <img src="@currentLogo" class="img-thumbnail rounded bg-light p-2" style="max-height: 80px; object-fit: contain;" />
                                </div>
                            }

                            <input class="form-control" asp-for="Logo" id="logoInput" type="file" accept=".jpg,.jpeg,.png,.webp,.svg" />
                            <small class="text-muted">Leave empty to keep current logo.</small><br />
                            <span asp-validation-for="Logo" class="text-danger"></span>

                            <div class="mt-2 d-none" id="newLogoPreviewContainer">
                                <p class="text-muted small mb-1">New Logo Preview:</p>
                                <img id="logoPreview" src="#" alt="New Preview" class="img-thumbnail rounded bg-light p-2" style="max-height: 80px; object-fit: contain;" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Update Partner Client
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {
            $('#logoInput').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    $('#logoPreview').attr('src', URL.createObjectURL(file));
                    $('#newLogoPreviewContainer').removeClass('d-none');
                } else {
                    $('#newLogoPreviewContainer').addClass('d-none');
                }
            });
        });
    </script>
}
