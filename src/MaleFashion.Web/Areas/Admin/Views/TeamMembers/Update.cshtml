@model MaleFashion.Web.Areas.Admin.Models.CMS.TeamMemberModel

@{
    ViewData["Title"] = "Edit Team Member";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0">Edit Team Member</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Back to List
                    </a>
                </div>
                <div class="card-body pt-4">
                    <partial name="_ResponsePartial" />

                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="PhotoUrl" />

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Name"></label>
                            <input class="form-control" asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Role / Position -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Role"></label>
                            <input class="form-control" asp-for="Role" />
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <!-- Current Photo & Replacement -->
                        <div class="mb-3">
                            <label class="form-label" asp-for="Photo"></label>

                            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                            {
                                <div class="mb-2" id="currentPhotoContainer">
                                    <p class="text-muted small mb-1">Current Photo:</p>
                                    <img src="/uploads/team/@Model.PhotoUrl" class="img-thumbnail rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                                </div>
                            }

                            <input class="form-control" asp-for="Photo" id="photoInput" type="file" accept=".jpg,.jpeg,.png,.webp" />
                            <small class="text-muted">Leave empty to keep current photo.</small><br />
                            <span asp-validation-for="Photo" class="text-danger"></span>

                            <div class="mt-2 d-none" id="newPhotoPreviewContainer">
                                <p class="text-muted small mb-1">New Photo Preview:</p>
                                <img id="photoPreview" src="#" alt="New Preview" class="img-thumbnail rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Update Team Member
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {
            $('#photoInput').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    $('#photoPreview').attr('src', URL.createObjectURL(file));
                    $('#newPhotoPreviewContainer').removeClass('d-none');
                } else {
                    $('#newPhotoPreviewContainer').addClass('d-none');
                }
            });
        });
    </script>
}

