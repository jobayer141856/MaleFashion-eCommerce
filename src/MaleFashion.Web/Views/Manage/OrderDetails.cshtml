@model MaleFashion.Web.Models.Account.Manage.CustomerOrderDetailsViewModel
@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
    ViewData["ActiveMenu"] = "MyOrders";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar (Col 3) -->
            <div class="col-lg-3 col-md-4">
                <partial name="_ManageSidebar" />
            </div>

            <!-- Main Content (Col 9) -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-0 text-dark">Order Details</h4>
                            <small class="text-muted">Order #@Model.OrderNumber &bull; Placed on @Model.OrderDate.ToString("MMM dd, yyyy - hh:mm tt")</small>
                        </div>
                        <div class="d-flex align-items-center">
                            @if (Model.Status == MaleFashion.Domain.Enums.OrderStatus.Pending)
                            {
                                <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" class="d-inline mr-2" onsubmit="return confirm('Are you sure you want to cancel order #@Model.OrderNumber?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger font-weight-bold">
                                        <i class="fa fa-times mr-1"></i> Cancel Order
                                    </button>
                                </form>
                            }
                            <a asp-action="Orders" class="btn btn-sm btn-outline-secondary font-weight-bold">
                                <i class="fa fa-arrow-left mr-1"></i> Back to Orders
                            </a>
                        </div>
                    </div>

                    <!-- Status & Payment Highlights -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-2">
                            <div class="p-3 bg-light rounded border">
                                <small class="text-muted font-weight-bold d-block">Order Status</small>
                                <div class="mt-1">
                                    @if (Model.Status == MaleFashion.Domain.Enums.OrderStatus.Delivered)
                                    {
                                        <span class="badge badge-success px-2 py-1">Delivered</span>
                                    }
                                    else if (Model.Status == MaleFashion.Domain.Enums.OrderStatus.Shipped)
                                    {
                                        <span class="badge badge-info px-2 py-1">Shipped</span>
                                    }
                                    else if (Model.Status == MaleFashion.Domain.Enums.OrderStatus.Processing)
                                    {
                                        <span class="badge badge-primary px-2 py-1">Processing</span>
                                    }
                                    else if (Model.Status == MaleFashion.Domain.Enums.OrderStatus.Cancelled)
                                    {
                                        <span class="badge badge-danger px-2 py-1">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning px-2 py-1">Pending</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="p-3 bg-light rounded border">
                                <small class="text-muted font-weight-bold d-block">Payment Method & Status</small>
                                <div class="mt-1">
                                    <strong class="text-dark">@Model.PaymentMethod</strong> &bull;
                                    <span class="badge badge-light border">@Model.PaymentStatus</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ordered Items Table -->
                    <h6 class="font-weight-bold text-dark mb-3">Purchased Items</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered mb-0">
                            <thead class="bg-light text-secondary small font-weight-bold">
                                <tr>
                                    <th>Item Description</th>
                                    <th class="text-center" style="width: 120px;">Unit Price</th>
                                    <th class="text-center" style="width: 80px;">Qty</th>
                                    <th class="text-right" style="width: 140px;">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td><strong class="text-dark">@item.ProductName</strong></td>
                                        <td class="text-center">৳ @item.UnitPrice.ToString("N2")</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-right font-weight-bold text-dark">৳ @item.TotalPrice.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Cost Breakdown & Delivery Address -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="p-3 border rounded h-100">
                                <h6 class="font-weight-bold text-dark mb-2">Delivery Address</h6>
                                <p class="text-muted small mb-0">@Model.ShippingAddressText</p>

                                @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
                                {
                                    <h6 class="font-weight-bold text-dark mt-3 mb-1">Customer Notes</h6>
                                    <p class="text-muted small mb-0">@Model.OrderNotes</p>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="p-3 border rounded bg-light">
                                <h6 class="font-weight-bold text-dark mb-3">Payment Summary</h6>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Subtotal:</span>
                                    <span class="text-dark font-weight-bold">৳ @Model.Subtotal.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Shipping Fee:</span>
                                    <span class="text-dark font-weight-bold">৳ @Model.ShippingCost.ToString("N2")</span>
                                </div>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <div class="d-flex justify-content-between small mb-1 text-success">
                                        <span>Discount:</span>
                                        <span class="font-weight-bold">- ৳ @Model.DiscountAmount.ToString("N2")</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                    <span class="font-weight-bold text-dark">Total:</span>
                                    <span class="h5 font-weight-bold text-danger mb-0" style="color: #e53637 !important;">৳ @Model.TotalAmount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-dashboard-card {
        border-radius: 4px;
        border: 1px solid #f0f0f0;
    }
</style>

