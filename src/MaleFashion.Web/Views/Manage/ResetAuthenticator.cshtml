@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset Authenticator Key";
    ViewData["ActiveMenu"] = "Security";
}

<div class="manage-account-wrapper py-4" style="background-color: #f7f7fa; min-height: 80vh;">
    <div class="container">
        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3 col-md-4">
                <partial name="Manage/_ManageSidebar" />
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="main-dashboard-card p-4 shadow-sm bg-white" style="border-radius: 4px; border: 1px solid #f0f0f0;">

                    <!-- Title Bar -->
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <h4 class="font-weight-bold mb-1 text-dark">Reset Authenticator Key</h4>
                            <p class="text-muted small mb-0">Revoke your current authenticator secret and generate a fresh setup key.</p>
                        </div>
                        <a asp-action="TwoFactorAuthentication" class="text-secondary small font-weight-bold">
                            <i class="fa fa-arrow-left mr-1"></i> Back to 2FA
                        </a>
                    </div>

                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show small mb-4" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <!-- Warning Callout Card -->
                    <div class="alert alert-warning border-left-warning p-4 mb-4" role="alert" style="border-left: 4px solid #ffc107; background-color: #fff9e6;">
                        <h6 class="font-weight-bold text-dark mb-2">
                            <i class="fa fa-exclamation-triangle text-warning mr-1"></i> If you reset your authenticator key, your current app will stop working!
                        </h6>
                        <p class="small text-muted mb-2">
                            This process invalidates your existing key and temporarily disables 2FA until you rescan the new QR code and verify your device.
                        </p>
                        <p class="small text-muted mb-0">
                            If you do not finish reconfiguring the authenticator app immediately afterward, you may be vulnerable to account lockout.
                        </p>
                    </div>

                    <!-- Reset Trigger Form -->
                    <form id="reset-authenticator-form" asp-action="ResetAuthenticator" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex align-items-center" style="gap: 10px;">
                            <button id="reset-authenticator-button" class="site-btn px-4 py-2" type="submit" style="background: #e53637;" onclick="return confirm('Are you sure you want to reset your authenticator key? Your current app codes will stop working.');">
                                <i class="fa fa-refresh mr-1"></i> Reset Authenticator Key
                            </button>
                            <a asp-action="TwoFactorAuthentication" class="btn btn-link text-muted font-weight-bold small">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>