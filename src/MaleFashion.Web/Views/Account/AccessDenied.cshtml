@{
    ViewData["Title"] = "Access Denied";
}

<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Security Alert</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Access Denied</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-10">
                <div class="card border-0 shadow-sm p-4 p-md-5 text-center" style="border-radius: 8px; background: #ffffff;">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                             style="width: 80px; height: 80px; background-color: #fff2f2;">
                            <i class="fa fa-ban text-danger" style="font-size: 38px;"></i>
                        </div>
                        <h3 class="font-weight-bold text-dark mb-2">Access Denied</h3>
                        <p class="text-muted mb-0">
                            You do not have permission to access this resource or page.
                        </p>
                    </div>

                    <div class="d-flex justify-content-center" style="gap: 10px;">
                        <a asp-controller="Home" asp-action="Index" class="site-btn px-4 py-2">
                            Return to Home
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="site-btn btn-sm px-4 py-2" style="background: #6c757d;">
                            Sign In with Different Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>